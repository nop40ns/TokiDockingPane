<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:TokiDockingPane"
    xmlns:models="clr-namespace:TokiDockingPane.Models"
    xmlns:viewModels="clr-namespace:TokiDockingPane.ViewModels">

    <!--  =========================================================================  -->
    <!--  👑 【最外殻統治スタイル】 DockingPaneViewModel をカスタムコントロールとして駆動  -->
    <!--  =========================================================================  -->
    <Style TargetType="{x:Type viewModels:DockingPaneViewModel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type viewModels:DockingPaneViewModel}">
                    <!--  ★ 開発者様設計の、美しい5列の絶対レイアウトをここにそのまま完全スタック！  -->
                    <Grid Background="#FF1E1E1E">
                        <Grid.ColumnDefinitions>
                            <!-- 列0: 左サイドバーバー（ピン留め解除されたツールが縦書きで格納される聖域） -->
                            <ColumnDefinition Width="Auto" />
                            <!-- 列1: 左ツールペイン（将来の拡張用拡張スロット） -->
                            <ColumnDefinition Width="Auto" />
                            <!-- 列2: 中央メイン（4画面自由分割ツリー IPaneNode が無限に大暴れする100%可変領域） -->
                            <ColumnDefinition Width="*" />
                            <!-- 列3: 🌟【大核心】：右ツールペインの幅。モデルの PaneSize (280) と GridLength 型でダイレクト双方向直結！ -->
                            <!-- これにより、GridSplitter を動かした衝撃が 1px の遅延もなくモデルの PaneSize へと吸い込まれてリサイズ可能になります！ -->
                            <ColumnDefinition Width="{Binding RightToolPane.PaneSize, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, Converter={StaticResource DoubleToGridLengthConverter}}" MinWidth="100"/>
                            <!-- 列4: 右サイドバーバー（ソリューションエクスプローラーが隠れた時の避難所） -->
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  🌟 [Column 2] 中央：これまでの最強4分割フォルダツリーを完全結合  -->
                        <!--  拡張プロパティとして、TemplateBinding で値をダイレクト一本釣りします  -->
                        <ContentPresenter Grid.Column="2" Content="{Binding RootDocumentNode, RelativeSource={RelativeSource TemplatedParent}}" />

                        <!--  🎯 [Column 3] 右側ツール枠：Docked（ピン留め）状態の時だけ表示  -->
                        <ContentPresenter
                            Grid.Column="3"
                            Width="280"
                            Content="{TemplateBinding RightToolPane}">
                            <ContentPresenter.Style>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <!--  TemplateBindingの値をトリガーで追跡するためのRelativeSource指定  -->
                                        <DataTrigger Binding="{Binding RightToolPane.State, RelativeSource={RelativeSource TemplatedParent}}" Value="Docked">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentPresenter.Style>
                        </ContentPresenter>

                        <!--  🎯 [Column 4] 右最外殻：AutoHidden時の「自動隠蔽バー」  -->
                        <Border
                            Grid.Column="4"
                            Width="24"
                            Background="#FF2D2D30"
                            BorderBrush="#FF3E3E42"
                            BorderThickness="1,0,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RightToolPane.State, RelativeSource={RelativeSource TemplatedParent}}" Value="AutoHidden">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Button
                                Background="Transparent"
                                BorderThickness="0"
                                Content="{Binding RightToolPane.Title, RelativeSource={RelativeSource TemplatedParent}}"
                                FontSize="11"
                                Foreground="#FFDFDFDF">
                                <Button.LayoutTransform>
                                    <RotateTransform Angle="90" />
                                </Button.LayoutTransform>
                            </Button>
                        </Border>

                        <!--  👻 [オーバーレイポップアップ]  -->
                        <Grid
                            Grid.Column="2"
                            Width="280"
                            HorizontalAlignment="Right"
                            Panel.ZIndex="99">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding RightToolPane.IsPopupOpened, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                                <Condition Binding="{Binding RightToolPane.State, RelativeSource={RelativeSource TemplatedParent}}" Value="AutoHidden" />
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.Setters>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger.Setters>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <DockPanel>
                                <ContentPresenter Content="{Binding RightToolPane, RelativeSource={RelativeSource TemplatedParent}}" />
                            </DockPanel>
                        </Grid>
 

                    </Grid>
                    
                    
                    
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  =========================================================================  -->
    <!--  🌲 【再帰解決エンジン】 具象クラス解決用の DataTemplate をここに配置  -->
    <!--  =========================================================================  -->
    <DataTemplate DataType="{x:Type models:PaneContentNode}">
        <local:DockingPane />
    </DataTemplate>

    <DataTemplate DataType="{x:Type models:ToolPaneContentNode}">
        <local:DockingPane />
    </DataTemplate>

    <!--  (この下に、local:DockingPane の Style セクションがそのまま続きます)  -->
    <!--  =========================================================================  -->
    <!--  🛠️ 【UIコアエンジン】中央ツリーと右ツールペインを1インフラで共通統治  -->
    <!--  =========================================================================  -->
    <Style TargetType="{x:Type local:DockingPane}">
        <Setter Property="Background" Value="#FF1E1E1E" />
        <Setter Property="BorderBrush" Value="#FF3E3E42" />
        <Setter Property="BorderThickness" Value="1" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:DockingPane}">
                    <Grid>
                        <!--  =========================================================================  -->
                        <!--  【状態②：マルチタブ実体状態（通常フォルダ ＆ ツール共通枠）】  -->
                        <!--  =========================================================================  -->
                        <Border
                            x:Name="LeafVisual"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Visibility="Collapsed">
                            <DockPanel>
                                <!--  ★【119行目付近修正】: RootDocumentNode. を完全に撤去し、自身の持つ TabViewModels へ直結  -->
                                <ItemsControl
                                    Background="#FF2D2D30"
                                    DockPanel.Dock="Top"
                                    ItemsSource="{Binding TabViewModels}">
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="{x:Type ItemsControl}">
                                            <Border Background="{TemplateBinding Background}" BorderThickness="0">
                                                <ScrollViewer
                                                    x:Name="PART_HeaderScrollViewer"
                                                    HorizontalScrollBarVisibility="Hidden"
                                                    VerticalScrollBarVisibility="Disabled">
                                                    <ItemsPresenter />
                                                </ScrollViewer>
                                            </Border>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>


                                    <!--  =========================================================================  -->
                                    <!--  ❌ 【タブアイテム・デザイン極限完成形】 可変伸縮による全部屋100%等倍フィット  -->
                                    <!--  =========================================================================  -->
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- WidthをAutoにし、Paddingで文字左右に美しい余白をホールド -->
                                            <Border x:Name="TabItemBorder" 
                                                    Width="Auto"
                                                    MinWidth="80" 
                                                    Margin="1,2,1,0" Padding="10,4,6,4" 
                                                    Background="#FF2D2D30" BorderBrush="#FF3E3E42" BorderThickness="1,1,1,0" 
                                                    CornerRadius="3,3,0,0" Cursor="Hand">

                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="20" />
                                                        <!-- ボタンとの間に4pxの余白を常時固定 -->
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Title名を表示（将来的にフォルダ名だけにするための布石としてTextTrimmingは維持） -->
                                                    <TextBlock Grid.Column="0"
                                                               FontSize="24" Foreground="#FFDFDFDF" 
                                                               Text="{Binding}" 
                                                               VerticalAlignment="Center"
                                                                HorizontalAlignment="Left"
                                                               ToolTip="{Binding}"/>

                                                    <Button x:Name="PART_TabCloseButton" 
                                                            Grid.Column="1"
                                                            Width="14" Height="14" 
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            Background="Transparent" 
                                                            BorderThickness="0" 
                                                            Cursor="Arrow"
                                                            Focusable="False">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="ButtonBorder" Background="Transparent" CornerRadius="2">
                                                                    <Path x:Name="CrossPath" Data="M3,3 L11,11 M11,3 L3,11" Stroke="#FF999999" StrokeThickness="1.2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="ButtonBorder" Property="Background" Value="#FFC42B1C"/>
                                                                        <Setter TargetName="CrossPath" Property="Stroke" Value="#FFFFFFFF"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                                <!--  0msタブ切り替えコアコンテナ  -->
                                <Grid x:Name="PART_TabContentContainer" Background="#FF1E1E1E">
                                    <!--  高密度ドッキング・インジケータ  -->
                                    <Grid
                                        x:Name="PART_DockingIndicator"
                                        Width="120"
                                        Height="120"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                        <Ellipse
                                            Fill="#80000000"
                                            Stroke="#FF3E3E42"
                                            StrokeThickness="1" />
                                        <Grid>
                                            <Border
                                                x:Name="PART_IndicatorCenter"
                                                Width="24"
                                                Height="24"
                                                Background="#FF2D2D30"
                                                BorderBrush="#FF007ACC"
                                                BorderThickness="1"
                                                CornerRadius="2">
                                                <Rectangle
                                                    Width="12"
                                                    Height="12"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Fill="#FF007ACC" />
                                            </Border>
                                            <Border
                                                x:Name="PART_IndicatorTop"
                                                Width="24"
                                                Height="24"
                                                Margin="0,4,0,0"
                                                VerticalAlignment="Top"
                                                Background="#FF2D2D30"
                                                BorderBrush="#FF007ACC"
                                                BorderThickness="1"
                                                CornerRadius="2">
                                                <Rectangle
                                                    Width="14"
                                                    Height="6"
                                                    Margin="0,3,0,0"
                                                    VerticalAlignment="Top"
                                                    Fill="#FF007ACC" />
                                            </Border>
                                            <Border
                                                x:Name="PART_IndicatorBottom"
                                                Width="24"
                                                Height="24"
                                                Margin="0,0,0,4"
                                                VerticalAlignment="Bottom"
                                                Background="#FF2D2D30"
                                                BorderBrush="#FF007ACC"
                                                BorderThickness="1"
                                                CornerRadius="2">
                                                <Rectangle
                                                    Width="14"
                                                    Height="6"
                                                    Margin="0,0,0,3"
                                                    VerticalAlignment="Bottom"
                                                    Fill="#FF007ACC" />
                                            </Border>
                                            <Border
                                                x:Name="PART_IndicatorLeft"
                                                Width="24"
                                                Height="24"
                                                Margin="4,0,0,0"
                                                HorizontalAlignment="Left"
                                                Background="#FF2D2D30"
                                                BorderBrush="#FF007ACC"
                                                BorderThickness="1"
                                                CornerRadius="2">
                                                <Rectangle
                                                    Width="6"
                                                    Height="14"
                                                    Margin="3,0,0,0"
                                                    HorizontalAlignment="Left"
                                                    Fill="#FF007ACC" />
                                            </Border>
                                            <Border
                                                x:Name="PART_IndicatorRight"
                                                Width="24"
                                                Height="24"
                                                Margin="0,0,4,0"
                                                HorizontalAlignment="Right"
                                                Background="#FF2D2D30"
                                                BorderBrush="#FF007ACC"
                                                BorderThickness="1"
                                                CornerRadius="2">
                                                <Rectangle
                                                    Width="6"
                                                    Height="14"
                                                    Margin="0,0,3,0"
                                                    HorizontalAlignment="Right"
                                                    Fill="#FF007ACC" />
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Grid>
                                
                                
                                
                            </DockPanel>
                        </Border>

                        <!--  =========================================================================  -->
                        <!--  🌲 【状態①：2分割コンテナ状態（縦割）】  -->
                        <!--  =========================================================================  -->
                        <!-- 【状態①：2分割コンテナ状態（縦割）】 -->
                        <Grid x:Name="PART_VerticalSplitGrid" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /> 
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" Content="{Binding MainChild}"  />
                            
                            
                            <!-- ★【修正】：ShowsPreview="False" を追記してリアルタイム比率再計算を強制起動！ -->
                            <GridSplitter Grid.Column="1" Width="4"  x:Name="PART_VerticalSplitBar"
                                          HorizontalAlignment="Stretch" 
                                          Background="#FF3E3E42" 
                                          ShowsPreview="False" />
                            
                            <ContentPresenter Grid.Column="2" Content="{Binding SubChild}" Grid.ColumnSpan="2" />

                            <!-- 🎯【縦スプリッター（赤線）連動ガイド線の一本釣り配置】 -->
                            <!-- スプリッターと同じ Column="1" に配置し、ドラッグ中（空中戦時）のみ Visible にします -->
                            <!-- レイキャストに引っかけるため、名前の頭文字を C# 側のHitTestと完全に同期させます -->
                            <Border x:Name="PART_VerticalSplitterIndicator" Grid.Column="1"
                                    Width="48" HorizontalAlignment="Center" VerticalAlignment="Stretch" 
                                    Background="#440000CC" BorderBrush="#FF007ACC" BorderThickness="1,0,1,0" 
                                    Visibility="Collapsed" IsHitTestVisible="True" Margin="-22,0,-22,0">
                                <Border.Effect>
                                    <BlurEffect Radius="2"/>
                                </Border.Effect>
                            </Border>


 
                        </Grid>

                        <!-- 【状態①：2分割コンテナ状態（横割）】 -->
                        <Grid x:Name="PART_HorizontalSplitGrid" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter Grid.Row="0" Content="{Binding MainChild}" />
                            <!-- ★【修正】：こちらも同様に追記 -->

                            <GridSplitter Grid.Row="1" Height="4" x:Name="PART_HorizontalSplitBar"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                                          Background="#FF3E3E42" 
                                          ShowsPreview="False" />

                            <ContentPresenter Grid.Row="2" Content="{Binding SubChild}" />

                            <!-- 🎯【新章：横スプリッター（青線）連動ガイドバー】 -->
                            <!-- スプリッターと同じ Row="1" に配置し、横を Stretch にすることで、 -->
                            <!-- 画面を横断する4画面中央の仕切り線の真上全域（横幅100%）に、美しい半透明青バーが自動追従して降臨！ -->
                            <Border x:Name="PART_HorizontalSplitterIndicator" Grid.Row="1"
                                    Height="48" VerticalAlignment="Center" HorizontalAlignment="Stretch" 
                                    Background="#440000CC" BorderBrush="#FF007ACC" BorderThickness="0,1,0,1" 
                                    Visibility="Collapsed" IsHitTestVisible="True" Margin="0,-22,0,-22">
                                <Border.Effect>
                                    <BlurEffect Radius="2"/>
                                </Border.Effect>
                            </Border>


                        </Grid>

                        <!--  VisualStateManagerによる超高速レイアウト・ステート統治  -->
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="LayoutStates">
                                <VisualState x:Name="LeafState">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LeafVisual" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="VerticalState">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_VerticalSplitGrid" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="HorizontalState">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_HorizontalSplitGrid" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                    
                    
                    
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
