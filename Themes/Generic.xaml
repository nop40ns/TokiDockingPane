<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:TokiDockingPane"
    xmlns:models="clr-namespace:TokiDockingPane.Models"
    xmlns:conv="clr-namespace:TokiDockingPane.Converters"
    xmlns:viewModels="clr-namespace:TokiDockingPane.ViewModels">
    <conv:DoubleToGridLengthConverter x:Key="DoubleToGridLengthConverter" />

    <!-- ========================================================================= -->
    <!-- 👑 【最外殻統治コントロール：DockingPaneViewModel の最終確定形態】          -->
    <!-- ========================================================================= -->
    <Style TargetType="{x:Type viewModels:DockingPaneViewModel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type viewModels:DockingPaneViewModel}">
                    <!-- 5列の極限VSインフラGrid。中央のメイン領域(Column 2)の比率を汚さずにツールを統治します -->
                    <Grid Background="#FF1E1E1E">
                        <Grid.ColumnDefinitions>
                            <!-- 列0: 左サイドバーバー（将来用） -->
                            <ColumnDefinition Width="Auto" />
                            <!-- 列1: 左ツールペイン（将来用） -->
                            <ColumnDefinition Width="Auto" />
                            <!-- 列2: 中央メイン（4画面自由分割ツリーが * 寸法で大暴れする100%可変領域） -->
                            <ColumnDefinition Width="*" />
                            <!-- 列3: 🌟右ツール幅。モデルの PaneSize (280) と Mode=TwoWay でダイレクト双方向直結！ -->
                            <ColumnDefinition x:Name="PART_RightToolColumn"  Width="{Binding RightToolPane.PaneSize, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, Converter={StaticResource DoubleToGridLengthConverter}}" MinWidth="100"/>
                            <!-- 列4: 右サイドバーバー（ピン留め解除されたソリューションエクスプローラーの避難所） -->
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 📦 列2：中央メイン領域（4画面自由分割ツリー） -->
                        <ContentPresenter x:Name="PART_MainContent" Grid.Column="2" 
                            Content="{Binding RootDocumentNode, RelativeSource={RelativeSource TemplatedParent}}" />


                        <!-- 📊 列2と列3の境界線：右ツールウィンドウリサイズ用の本物の GridSplitter -->
                        <!-- 列3の左端に配置。ShowsPreview="False" により、ドラッグ中にリアルタイムに右ツール幅が変化します -->
                        <GridSplitter Grid.Column="3" Width="4"  x:Name="PART_RightToolSplitter"
                                      HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                      Background="#FF3E3E42" ShowsPreview="False"/>

                        <!-- 🏢 列3：右ツールペイン（ソリューションエクスプローラーの実体固定スロット） -->
                        <Border x:Name="PART_RightToolDockSlot" Grid.Column="3" 
                                Background="#FF2D2D30" BorderBrush="#FF3E3E42" BorderThickness="1,0,0,0"
                                Margin="4,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="32"/>
                                    <!-- ツールヘッダー（引き抜きドラッグ対象） -->
                                    <RowDefinition Height="*"/>
                                    <!-- ツールコンテンツ領域 -->
                                </Grid.RowDefinitions>

                                <!-- 🛠️ ツールヘッダーバー（引き抜き移動対応版） -->
                                <!-- Tagプロパティを経由して、このツールペインのDataContextをC#へパッシングし、共通D&Dをキック！ -->
                                <!-- ★【修正】：Padding="6,0" を完全に削除！ -->
                                <Grid Grid.Row="0" Background="#FF3E3E42" x:Name="PART_ToolHeader"
      Tag="{Binding RightToolPane, RelativeSource={RelativeSource TemplatedParent}}"
      IsHitTestVisible="True">

                                    <TextBlock Text="{Binding RightToolPane.Title, RelativeSource={RelativeSource TemplatedParent}}" 
                                               Foreground="#FFDFDFDF" VerticalAlignment="Center" FontSize="12" FontWeight="Bold"
                                               IsHitTestVisible="False"/>

                                    <!-- 📌 ピン留め（TogglePin）ボタン -->
                                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
        Command="{Binding Path=DataContext.RightToolPane.TogglePinCommand, RelativeSource={RelativeSource AncestorType={x:Type viewModels:DockingPaneViewModel}}}"
        Background="Transparent" BorderThickness="0" Width="20" Height="20" Cursor="Hand">
                                        <Grid>
                                            <!-- 通常のButtonなので、このアイコンの向きのコントロールは下部のDataTriggerが100%安全に行います -->
                                            <Path x:Name="PART_PinIcon" Data="M10,2 L10,6 M6,6 L14,6 M8,6 L8,14 M5,14 L15,14 M10,14 L10,18" 
              Stroke="#FF999999" StrokeThickness="1.5" RenderTransformOrigin="0.5,0.5"/>
                                        </Grid>
                                    </Button>
                                </Grid>

                                <!-- 📁 ツール内部コンテンツ（ツリーやDataGrid用） -->
                                <ContentPresenter Grid.Row="1" Content="{Binding RightToolPane, RelativeSource={RelativeSource TemplatedParent}}" />

                            </Grid>
                        </Border>

                        <!-- ◀ 列4：右サイドバー（ピン留めが外された時に、ここに縦書きで格納される） -->
                        <Border Grid.Column="4" Background="#FF2D2D30" Width="24" x:Name="PART_RightSideBar" Visibility="Collapsed">
                            <!-- クリックまたはホバーされた瞬間に OpenPopupCommand を叩いてポップアップを顕現 -->
                            <Button Content="{Binding RightToolPane.Title, RelativeSource={RelativeSource TemplatedParent}}" 
                                    Command="{Binding RightToolPane.OpenPopupCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                    Foreground="#FFDFDFDF" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <Button.LayoutTransform>
                                    <RotateTransform Angle="90"/>
                                    <!-- 縦書きボタンにトランスフォーム！ -->
                                </Button.LayoutTransform>
                            </Button>
                        </Border>

                        <!-- 👻 【VS形態：ホバーポップアップレイヤ】 -->
                        <!-- State==AutoHidden かつ IsPopupOpened==True の時だけ、メイン画面の右上(Column 2)にふわっと最前面オーバーレイ出現 -->
                        <!-- 👻 【VS形態：ホバーポップアップレイヤ最終解決版】 -->
                        <!-- Background="Transparent" によって、目に見えない衝突判定のバリアを広げ、マウスの離脱を100%検知します -->
                        <!-- 👻 【VS形態：ホバーポップアップレイヤ最終確定形態】 -->
                        <!-- Background="Transparent" によって、目に見えない透明な衝突のバリアを広げます -->
                        <!-- 🌟【解決】：WPFのUI要素自体の直下に、マウスが外れた（MouseLeave）瞬間に -->
                        <!-- 開発者様がC#側に用意してくださった本物の『ClosePopupCommand』を -->
                        <!-- 最外殻（AncestorType）から一本釣りでダイレクトに叩かせるためのインフラを仕込みます！ -->
                        <!-- 👻 【VS形態：ホバーポップアップレイヤ最終確定形態】 -->
                        <!-- Background="Transparent" によって、目に見えない透明な衝突判定の翼を全域に広げます -->
                        <!-- 🌟【核心修正】：WPF標準の超軽量 EventTrigger をダイレクトインサート！ -->
                        <!-- 複雑なアニメーション(Storyboard)でC#変数を跨ごうとすると例外が出るため、 -->
                        <!-- マウスが離脱したその0.001ミリ秒の瞬間に、Popup自身のVisibilityプロパティを直接「Collapsed」に叩き落とし、 -->
                        <!-- 同時に、最外殻のプロパティ（RightToolPane.IsPopupOpened）に対しても、WPF純正のプロパティ直接代入（SetStoryboard）で【False】を上書き送還します！ -->
                        <!-- 👻 【VS形態：ホバーポップアップレイヤ最終確定形態】 -->
                        <!-- Background="Transparent" によって、目に見えない透明な衝突のバリアを広げます -->
                        <!-- 👻 【VS形態：ホバーポップアップレイヤ・正真正銘の最終完全形態】 -->
                        <!-- 開発者様の絶対正義の「純粋なGrid」の姿のまま完全開通させます！ -->
                        <!-- Background="Transparent" によって、目に見えない衝突判定のバリアを広げます -->
                        <Grid Grid.Column="2" Grid.ColumnSpan="2" HorizontalAlignment="Right" Panel.ZIndex="99" 
                              Background="Transparent"
                              Width="{Binding RightToolPane.PaneSize, RelativeSource={RelativeSource TemplatedParent}}" 
                              x:Name="PART_RightToolPopup" Visibility="Collapsed">

                            <!-- 📁 ツール内部コンテンツ（文字色白化ホールド） -->
                            <Border Background="#FF2D2D30" BorderBrush="#FF007ACC" BorderThickness="1,1,1,1" Margin="0,1,0,1"
                                    TextBlock.FontSize="12" TextBlock.Foreground="#FFDFDFDF">
                                <Grid>
                                    <ContentPresenter Content="{Binding RightToolPane.ActiveViewModel, RelativeSource={RelativeSource TemplatedParent}}"  />
                                </Grid>
                            </Border>

                         
                        </Grid>



                    </Grid>

                    <!-- ========================================================================= -->
                    <!-- 🎯【トリガーセクション最終形】：開閉のコンフリクトを完全消滅させた黄金比      -->
                    <!-- ========================================================================= -->
                    <!-- ========================================================================= -->
                    <!-- 🎯【トリガーセクション最終形】：すべてのコンフリクト・例外を完全粉砕          -->
                    <!-- ========================================================================= -->
                    <!-- ========================================================================= -->
                    <!-- 🎯【トリガーセクション最終形】：開閉のコンフリクトを完全消滅させた黄金比      -->
                    <!-- ========================================================================= -->
                    <ControlTemplate.Triggers>

                        <!-- 🟩 状態①：普段ピンで固定されている通常時（Docked） -->
                        <DataTrigger Binding="{Binding RightToolPane.State, RelativeSource={RelativeSource Self}}" Value="Docked">
                            <Setter TargetName="PART_RightToolColumn" Property="MinWidth" Value="100"/>
                        </DataTrigger>

                        <!-- 🔷 状態②：ピン留めボタンが押され、自動格納状態（AutoHidden）になった瞬間！ -->
                        <DataTrigger Binding="{Binding RightToolPane.State, RelativeSource={RelativeSource Self}}" Value="AutoHidden">
                            <Setter TargetName="PART_RightToolColumn" Property="Width" Value="Auto"/>
                            <Setter TargetName="PART_RightToolColumn" Property="MinWidth" Value="0"/>
                            <Setter TargetName="PART_RightToolSplitter" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_RightToolDockSlot" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_RightSideBar" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PART_MainContent" Property="Grid.ColumnSpan" Value="2"/>
                            <Setter TargetName="PART_PinIcon" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90"/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>

                        <!-- 🔷 状態③：AutoHidden 状態で、かつデータ（IsPopupOpened）が True の時だけポップアップをVisible化！ -->
                        <!-- 競合する IsMouseOver 条件を完全に撤去したため、クリックした瞬間に0msで即死するフリーズは100%消滅します -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RightToolPane.State, RelativeSource={RelativeSource Self}}" Value="AutoHidden"/>
                                <Condition Binding="{Binding RightToolPane.IsPopupOpened, RelativeSource={RelativeSource Self}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PART_RightToolPopup" Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>


                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  =========================================================================  -->
    <!--  🌲 【再帰解決エンジン】 具象クラス解決用の DataTemplate をここに配置  -->
    <!--  =========================================================================  -->
    <!-- ========================================================================= -->
    <!-- 🌲 【再帰解決エンジン】 具象クラス解決用の DataTemplate                       -->
    <!-- ========================================================================= -->
    <DataTemplate DataType="{x:Type models:PaneContentNode}">
        <local:DockingPane />
    </DataTemplate>

    <DataTemplate DataType="{x:Type models:ToolPaneContentNode}">
        <local:DockingPane />

    </DataTemplate>

    <!-- ========================================================================= -->
    <!-- 🛠️ 【UIコアエンジン】中央ツリーと右ツールペインを1インフラで共通統治          -->
    <!-- ========================================================================= -->
    <Style TargetType="{x:Type local:DockingPane}">
        <Setter Property="Background" Value="#FF1E1E1E" />
        <Setter Property="BorderBrush" Value="#FF3E3E42" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:DockingPane}">
                    <Grid>
                        <!-- 【状態②：マルチタブ実体状態（通常フォルダ ＆ ツール共通枠）】 -->
                        <Border x:Name="LeafVisual" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Visibility="Collapsed">
                            <DockPanel>
                                <ItemsControl Background="#FF2D2D30" DockPanel.Dock="Top" ItemsSource="{Binding TabViewModels}">
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="{x:Type ItemsControl}">
                                            <Border Background="{TemplateBinding Background}" BorderThickness="0">
                                                <ScrollViewer x:Name="PART_HeaderScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                                                    <ItemsPresenter />
                                                </ScrollViewer>
                                            </Border>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="TabItemBorder" Width="Auto" MinWidth="80" Margin="1,2,1,0" Padding="10,4,6,4" Background="#FF2D2D30" BorderBrush="#FF3E3E42" BorderThickness="1,1,1,0" CornerRadius="3,3,0,0" Cursor="Hand">
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="20" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" FontSize="24" Foreground="#FFDFDFDF" Text="{Binding Title}" VerticalAlignment="Center" HorizontalAlignment="Left" ToolTip="{Binding Title}"/>
                                                    <Button x:Name="PART_TabCloseButton" Grid.Column="1" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Cursor="Arrow" Focusable="False">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="ButtonBorder" Background="Transparent" CornerRadius="2">
                                                                    <Path x:Name="CrossPath" Data="M3,3 L11,11 M11,3 L3,11" Stroke="#FF999999" StrokeThickness="1.2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="ButtonBorder" Property="Background" Value="#FFC42B1C"/>
                                                                        <Setter TargetName="CrossPath" Property="Stroke" Value="#FFFFFFFF"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid x:Name="PART_TabContentContainer" Background="#FF1E1E1E" TextBlock.Foreground="#FFDFDFDF">
                                    <ContentPresenter Content="{Binding ActiveViewModel}" />
                                    <Grid x:Name="PART_DockingIndicator" Width="120" Height="120" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                          
                                          
                                          Visibility="Collapsed">
                                        <Ellipse Fill="#80000000" Stroke="#FF3E3E42" StrokeThickness="1" />
                                        <Grid>
                                            <Border x:Name="PART_IndicatorCenter" Width="24" Height="24" Background="#FF2D2D30" BorderBrush="#FF007ACC" BorderThickness="1" CornerRadius="2">
                                                <Rectangle Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#FF007ACC" />
                                            </Border>
                                            <Border x:Name="PART_IndicatorTop" Width="24" Height="24" Margin="0,4,0,0" VerticalAlignment="Top" Background="#FF2D2D30" BorderBrush="#FF007ACC" BorderThickness="1" CornerRadius="2">
                                                <Rectangle Width="14" Height="6" Margin="0,3,0,0" VerticalAlignment="Top" Fill="#FF007ACC" />
                                            </Border>
                                            <Border x:Name="PART_IndicatorBottom" Width="24" Height="24" Margin="0,0,0,4" VerticalAlignment="Bottom" Background="#FF2D2D30" BorderBrush="#FF007ACC" BorderThickness="1" CornerRadius="2">
                                                <Rectangle Width="14" Height="6" Margin="0,0,0,3" VerticalAlignment="Bottom" Fill="#FF007ACC" />
                                            </Border>
                                            <Border x:Name="PART_IndicatorLeft" Width="24" Height="24" Margin="4,0,0,0" HorizontalAlignment="Left" Background="#FF2D2D30" BorderBrush="#FF007ACC" BorderThickness="1" CornerRadius="2">
                                                <Rectangle Width="6" Height="14" Margin="3,0,0,0" HorizontalAlignment="Left" Fill="#FF007ACC" />
                                            </Border>
                                            <Border x:Name="PART_IndicatorRight" Width="24" Height="24" Margin="0,0,4,0" HorizontalAlignment="Right" Background="#FF2D2D30" BorderBrush="#FF007ACC" BorderThickness="1" CornerRadius="2">
                                                <Rectangle Width="6" Height="14" Margin="0,0,3,0" HorizontalAlignment="Right" Fill="#FF007ACC" />
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </DockPanel>
                        </Border>
                        
                        
                        <Grid x:Name="PART_VerticalSplitGrid" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" Content="{Binding MainChild}" />
                            <GridSplitter Grid.Column="1" Width="4" x:Name="PART_VerticalSplitBar" HorizontalAlignment="Stretch" Background="#FF3E3E42" ShowsPreview="False" />
                            <ContentPresenter Grid.Column="2" Content="{Binding SubChild}" />
                            <Border x:Name="PART_VerticalSplitterIndicator" Grid.Column="1" Width="48" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#440000CC" BorderBrush="#FF007ACC" BorderThickness="1,0,1,0" Visibility="Collapsed" IsHitTestVisible="True" Margin="-22,0,-22,0">
                                <Border.Effect>
                                    <BlurEffect Radius="2"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                        <Grid x:Name="PART_HorizontalSplitGrid" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter Grid.Row="0" Content="{Binding MainChild}" />
                            <GridSplitter Grid.Row="1" Height="4" x:Name="PART_HorizontalSplitBar" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#FF3E3E42" ShowsPreview="False" />
                            <ContentPresenter Grid.Row="2" Content="{Binding SubChild}" />
                            <Border x:Name="PART_HorizontalSplitterIndicator" Grid.Row="1" Height="48" VerticalAlignment="Center" HorizontalAlignment="Stretch" Background="#440000CC" BorderBrush="#FF007ACC" BorderThickness="0,1,0,1" Visibility="Collapsed" IsHitTestVisible="True" Margin="0,-22,0,-22">
                                <Border.Effect>
                                    <BlurEffect Radius="2"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                        
                        
                        
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="LayoutStates">
                                <VisualState x:Name="LeafState">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LeafVisual" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="VerticalState">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_VerticalSplitGrid" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="HorizontalState">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_HorizontalSplitGrid" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
