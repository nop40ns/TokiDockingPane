<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:TokiDockingPane.Converters"
    xmlns:local="clr-namespace:TokiDockingPane"
    xmlns:models="clr-namespace:TokiDockingPane.Models"
    xmlns:viewModels="clr-namespace:TokiDockingPane.ViewModels">

    <conv:DoubleToGridLengthConverter x:Key="DoubleToGridLengthConverter" />
    <conv:TrueToCollapsedConverter x:Key="TrueToCollapsedConverter" />

    <!--  =========================================================================  -->
    <!--  👑 【最外殻統治コントロール：DockingPaneViewModel の最終確定形態】  -->
    <!--  =========================================================================  -->
    <Style TargetType="{x:Type viewModels:DockingPaneViewModel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type viewModels:DockingPaneViewModel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>


                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>

                        <Grid
                            Grid.Row="2"
                            Grid.Column="2"
                            Background="#FF1E1E1E">


                            <!--  📦 列2：中央メイン領域（4画面自由分割ツリー）  -->
                            <ContentPresenter
                                x:Name="PART_MainContent"
                                Grid.Column="2"
                                Content="{Binding RootDocumentNode, RelativeSource={RelativeSource TemplatedParent}}" />

                            <Grid
                                x:Name="PART_IndicatorOuter"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Panel.ZIndex="9999"
                                Background="Transparent"
                                IsHitTestVisible="False"
                                Visibility="Collapsed">


                                <Border
                                    x:Name="PART_IndicatorOuterTop"
                                    Width="24"
                                    Height="24"
                                    Margin="0,4,0,0"
                                    VerticalAlignment="Top"
                                    AllowDrop="True"
                                    Background="#FF2D2D30"
                                    BorderBrush="#FF007ACC"
                                    BorderThickness="1"
                                    CornerRadius="2">
                                    <Rectangle
                                        Width="14"
                                        Height="6"
                                        Margin="0,3,0,0"
                                        VerticalAlignment="Top"
                                        Fill="#FF007ACC" />
                                </Border>
                                <Border
                                    x:Name="PART_IndicatorOuterBottom"
                                    Width="24"
                                    Height="24"
                                    Margin="0,0,0,4"
                                    VerticalAlignment="Bottom"
                                    AllowDrop="True"
                                    Background="#FF2D2D30"
                                    BorderBrush="#FF007ACC"
                                    BorderThickness="1"
                                    CornerRadius="2">
                                    <Rectangle
                                        Width="14"
                                        Height="6"
                                        Margin="0,0,0,3"
                                        VerticalAlignment="Bottom"
                                        Fill="#FF007ACC" />
                                </Border>
                                <Border
                                    x:Name="PART_IndicatorOuterLeft"
                                    Width="24"
                                    Height="24"
                                    Margin="4,0,0,0"
                                    HorizontalAlignment="Left"
                                    AllowDrop="True"
                                    Background="#FF2D2D30"
                                    BorderBrush="#FF007ACC"
                                    BorderThickness="1"
                                    CornerRadius="2">
                                    <Rectangle
                                        Width="6"
                                        Height="14"
                                        Margin="3,0,0,0"
                                        HorizontalAlignment="Left"
                                        Fill="#FF007ACC" />
                                </Border>
                                <Border
                                    x:Name="PART_IndicatorOuterRight"
                                    Width="24"
                                    Height="24"
                                    Margin="0,0,4,0"
                                    HorizontalAlignment="Right"
                                    AllowDrop="True"
                                    Background="#FF2D2D30"
                                    BorderBrush="#FF007ACC"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    IsHitTestVisible="True">

                                    <Rectangle
                                        Width="6"
                                        Height="14"
                                        Margin="0,0,3,0"
                                        HorizontalAlignment="Right"
                                        Fill="#FF007ACC" />
                                </Border>
                            </Grid>


                        </Grid>

                        <ItemsControl ItemsSource="{Binding RightHiddenPanes}"
                      Grid.Column="4"
                      Grid.Row="0"
                      Grid.RowSpan="5"
                      Width="Auto"
                      Background="#FF2D2D30"
                      BorderBrush="#FF3F3F46"
                      BorderThickness="1,0,0,0">

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" Margin="0,10,0,0"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,5" Padding="6,12,6,12" Background="Transparent" Cursor="Hand">
                                        <TextBlock Text="{Binding SelectedTab.Title}" FontSize="12" Foreground="#FFDCDCDC">
                                            <TextBlock.LayoutTransform>
                                                <RotateTransform Angle="90" />
                                                <!-- 90度回転させて美しい縦書き -->
                                            </TextBlock.LayoutTransform>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </Grid>


                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  =========================================================================  -->
    <!--  🌲 【再帰解決エンジン】 具象クラス解決用の DataTemplate をここに配置  -->
    <!--  =========================================================================  -->
    <!--  =========================================================================  -->
    <!--  🌲 【再帰解決エンジン】 具象クラス解決用の DataTemplate  -->
    <!--  =========================================================================  -->
    <DataTemplate DataType="{x:Type models:PaneContentNode}">
        <local:DockingPane />
    </DataTemplate>



    <!--  =========================================================================  -->
    <!--  🛠️ 【UIコアエンジン】中央ツリーと右ツールペインを1インフラで共通統治  -->
    <!--  =========================================================================  -->
    <Style TargetType="{x:Type local:DockingPane}">
        <Setter Property="Background" Value="#FF1E1E1E" />
        <Setter Property="BorderBrush" Value="#FF3E3E42" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:DockingPane}">
                    <Grid Visibility="{Binding IsAutoHidden, Converter={StaticResource TrueToCollapsedConverter}}">
                        <!--  【状態②：マルチタブ実体状態（通常フォルダ ＆ ツール共通枠）】  -->
                        <Border
                            x:Name="LeafVisual"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Visibility="Collapsed">
                            <DockPanel>
                                <ItemsControl
                                    x:Name="PART_TabHeader"
                                    Background="#FF2D2D30"
                                    DockPanel.Dock="Top"
                                    ItemsSource="{Binding TabViewModels}">
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="{x:Type ItemsControl}">
                                            <Border Background="{TemplateBinding Background}" BorderThickness="0">
                                                <ScrollViewer
                                                    x:Name="PART_HeaderScrollViewer"
                                                    HorizontalScrollBarVisibility="Hidden"
                                                    VerticalScrollBarVisibility="Disabled">
                                                    <ItemsPresenter />
                                                </ScrollViewer>
                                            </Border>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                x:Name="TabItemBorder"
                                                Width="Auto"
                                                MinWidth="80"
                                                Margin="1,2,1,0"
                                                Padding="10,4,6,4"
                                                Background="#FF2D2D30"
                                                BorderBrush="#FF3E3E42"
                                                BorderThickness="1,1,1,0"
                                                CornerRadius="3,3,0,0"
                                                Cursor="Hand">

                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="20" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        FontSize="24"
                                                        Foreground="#FFDFDFDF"
                                                        Text="{Binding Title}"
                                                        ToolTip="{Binding Title}" />
                                                    <Button
                                                        x:Name="PART_TabCloseButton"
                                                        Grid.Column="1"
                                                        Width="14"
                                                        Height="14"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Arrow"
                                                        Focusable="False">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border
                                                                    x:Name="ButtonBorder"
                                                                    Background="Transparent"
                                                                    CornerRadius="2">
                                                                    <Path
                                                                        x:Name="CrossPath"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        Data="M3,3 L11,11 M11,3 L3,11"
                                                                        Stroke="#FF999999"
                                                                        StrokeThickness="1.2" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="ButtonBorder" Property="Background" Value="#FFC42B1C" />
                                                                        <Setter TargetName="CrossPath" Property="Stroke" Value="#FFFFFFFF" />
                                                                    </Trigger>

                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>

                                                    <Button
                                                        x:Name="PART_PinButton"
                                                        Grid.Column="2"
                                                        Width="16"
                                                        Height="16"
                                                        Margin="0,0,5,0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType={x:Type local:DockingPane}}}"
        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type viewModels:DockingPaneViewModel}}}" 
                                                    ToolTip="自動的に隠す"
                                                        Visibility="Visible">
                                                        <!--  💡 引数として現在のタブ（TabViewModel）を念のため渡しておきます  -->
                                                        >
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <!--  💡 解決の核心：まずは Grid や Border などのビジュアル（実体）を先に全て定義します  -->
                                                                <Border Background="Transparent">
                                                                    <Path
                                                                        x:Name="PinPath"
                                                                        Data="M8,2 L8,7 M5,4 L11,4 M5,7 L11,7 M6,7 L6,11 L8,14 L10,11 L10,7"
                                                                        RenderTransformOrigin="0.5,0.5"
                                                                        Stroke="#FF999999"
                                                                        StrokeThickness="1.2">
                                                                        <Path.RenderTransform>
                                                                            <RotateTransform x:Name="PinRotation" Angle="0" />



                                                                        </Path.RenderTransform>
                                                                        <Path.Style>
                                                                            <Style TargetType="Path">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding DataContext.IsAutoHidden, RelativeSource={RelativeSource AncestorType={x:Type local:DockingPane}}}" Value="True">
                                                                                        <Setter Property="RenderTransform">
                                                                                            <Setter.Value>
                                                                                                <!--  ⚡ ターゲット名を使わずに、トランスフォームごと-90度に差し替えます！  -->
                                                                                                <RotateTransform Angle="-90" />
                                                                                            </Setter.Value>
                                                                                        </Setter>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Path.Style>
                                                                    </Path>
                                                                </Border>

                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid
                                    x:Name="PART_TabContentContainer"
                                    Background="#FF1E1E1E"
                                    TextBlock.Foreground="#FFDFDFDF">
                                    <ContentPresenter Content="{Binding DataContext.ActiveViewModel, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <Grid
                                        x:Name="PART_DockingIndicator"
                                        Width="120"
                                        Height="120"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                        <Ellipse
                                            Fill="#80000000"
                                            Stroke="#FF3E3E42"
                                            StrokeThickness="1" />
                                        <Grid>
                                            <Border
                                                x:Name="PART_IndicatorCenter"
                                                Width="24"
                                                Height="24"
                                                Background="#FF2D2D30"
                                                BorderBrush="#FF007ACC"
                                                BorderThickness="1"
                                                CornerRadius="2"
                                                Visibility="{Binding IsToolPane, Converter={StaticResource TrueToCollapsedConverter}}">
                                                <Rectangle
                                                    Width="12"
                                                    Height="12"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Fill="#FF007ACC" />
                                            </Border>
                                            <Border
                                                x:Name="PART_IndicatorTop"
                                                Width="24"
                                                Height="24"
                                                Margin="0,4,0,0"
                                                VerticalAlignment="Top"
                                                Background="#FF2D2D30"
                                                BorderBrush="#FF007ACC"
                                                BorderThickness="1"
                                                CornerRadius="2">
                                                <Rectangle
                                                    Width="14"
                                                    Height="6"
                                                    Margin="0,3,0,0"
                                                    VerticalAlignment="Top"
                                                    Fill="#FF007ACC" />
                                            </Border>
                                            <Border
                                                x:Name="PART_IndicatorBottom"
                                                Width="24"
                                                Height="24"
                                                Margin="0,0,0,4"
                                                VerticalAlignment="Bottom"
                                                Background="#FF2D2D30"
                                                BorderBrush="#FF007ACC"
                                                BorderThickness="1"
                                                CornerRadius="2">
                                                <Rectangle
                                                    Width="14"
                                                    Height="6"
                                                    Margin="0,0,0,3"
                                                    VerticalAlignment="Bottom"
                                                    Fill="#FF007ACC" />
                                            </Border>
                                            <Border
                                                x:Name="PART_IndicatorLeft"
                                                Width="24"
                                                Height="24"
                                                Margin="4,0,0,0"
                                                HorizontalAlignment="Left"
                                                Background="#FF2D2D30"
                                                BorderBrush="#FF007ACC"
                                                BorderThickness="1"
                                                CornerRadius="2">
                                                <Rectangle
                                                    Width="6"
                                                    Height="14"
                                                    Margin="3,0,0,0"
                                                    HorizontalAlignment="Left"
                                                    Fill="#FF007ACC" />
                                            </Border>
                                            <Border
                                                x:Name="PART_IndicatorRight"
                                                Width="24"
                                                Height="24"
                                                Margin="0,0,4,0"
                                                HorizontalAlignment="Right"
                                                Background="#FF2D2D30"
                                                BorderBrush="#FF007ACC"
                                                BorderThickness="1"
                                                CornerRadius="2">
                                                <Rectangle
                                                    Width="6"
                                                    Height="14"
                                                    Margin="0,0,3,0"
                                                    HorizontalAlignment="Right"
                                                    Fill="#FF007ACC" />
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </DockPanel>
                        </Border>


                        <Grid x:Name="PART_VerticalSplitGrid" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" Content="{Binding MainChild}" />
                            <GridSplitter
                                x:Name="PART_VerticalSplitBar"
                                Grid.Column="1"
                                Width="4"
                                HorizontalAlignment="Stretch"
                                Background="#FF3E3E42"
                                ShowsPreview="False" />
                            <ContentPresenter Grid.Column="2" Content="{Binding SubChild}" />
                            <Border
                                x:Name="PART_VerticalSplitterIndicator"
                                Grid.Column="1"
                                Width="48"
                                Margin="-22,0,-22,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Stretch"
                                Background="#440000CC"
                                BorderBrush="#FF007ACC"
                                BorderThickness="1,0,1,0"
                                IsHitTestVisible="True"
                                Visibility="Collapsed">
                                <Border.Effect>
                                    <BlurEffect Radius="2" />
                                </Border.Effect>
                            </Border>
                        </Grid>
                        <Grid x:Name="PART_HorizontalSplitGrid" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter Grid.Row="0" Content="{Binding MainChild}" />

                            <GridSplitter
                                x:Name="PART_HorizontalSplitBar"
                                Grid.Row="1"
                                Height="4"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Background="#FF3E3E42"
                                ShowsPreview="False" />
                            <ContentPresenter Grid.Row="2" Content="{Binding SubChild}" />

                            <Border
                                x:Name="PART_HorizontalSplitterIndicator"
                                Grid.Row="1"
                                Height="48"
                                Margin="0,-22,0,-22"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Background="#440000CC"
                                BorderBrush="#FF007ACC"
                                BorderThickness="0,1,0,1"
                                IsHitTestVisible="True"
                                Visibility="Collapsed">
                                <Border.Effect>
                                    <BlurEffect Radius="2" />
                                </Border.Effect>
                            </Border>
                        </Grid>



                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="LayoutStates">
                                <VisualState x:Name="LeafState">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LeafVisual" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="VerticalState">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_VerticalSplitGrid" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="HorizontalState">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_HorizontalSplitGrid" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!--  💡 部屋のDataContext（PaneContentNode）の IsToolPane が True のとき発動  -->
                        <DataTrigger Binding="{Binding IsToolPane}" Value="True">

                            <!--  1. タブヘッダー（PART_TabHeader）を DockPanel の「下（Bottom）」に引っ越しさせる！  -->
                            <Setter TargetName="PART_TabHeader" Property="DockPanel.Dock" Value="Bottom" />

                            <!--  2. ツールウィンドウ専用の背景色と枠線に変更する（VS風の少し明るいグレー）  -->
                            <Setter Property="Background" Value="#FF2D2D30" />
                            <Setter Property="BorderBrush" Value="#FF3F3F46" />

                        </DataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsToolPane}" Value="True" />
                                <Condition Binding="{Binding IsAutoHidden}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.Setters>
                                <Setter TargetName="PART_TabHeader" Property="DockPanel.Dock" Value="Right" />
                                <Setter TargetName="PART_TabContentContainer" Property="Visibility" Value="Collapsed" />

                            </MultiDataTrigger.Setters>
                        </MultiDataTrigger>


                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>



    </Style>
</ResourceDictionary>
