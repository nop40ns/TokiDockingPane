<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:TokiDockingPane.Converters"
    xmlns:local="clr-namespace:TokiDockingPane"
    xmlns:models="clr-namespace:TokiDockingPane.Models"
    xmlns:sysDiag="clr-namespace:System.Diagnostics;assembly=WindowsBase"
    xmlns:uc="clr-namespace:TokiDockingPane.UserControls"
    xmlns:Interfaces="clr-namespace:TokiDockingPane.Interfaces"
    xmlns:viewModels="clr-namespace:TokiDockingPane.ViewModels">

    
    <conv:DoubleToGridLengthConverter x:Key="DoubleToGridLengthConverter" />
    <conv:TrueToCollapsedConverter x:Key="TrueToCollapsedConverter" />

    <!--  =========================================================================  -->
    <!--  👑 【最外殻統治コントロール：DockingPaneViewModel の最終確定形態】  -->
    <!--  =========================================================================  -->
    <Style TargetType="{x:Type viewModels:DockingPaneViewModel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type viewModels:DockingPaneViewModel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!--  0: 上端サイドバー  -->
                            <RowDefinition Height="auto" />

                            <!--  1: 上常設ツール  -->
                            <RowDefinition
                                x:Name="Row_TopTool"
                                Height="auto"
                                MinHeight="0" />
                            <!--  2: 上セパレータ用通路  -->
                            <RowDefinition Height="auto" />

                            <!--  3: ★中央メイン領域  -->
                            <RowDefinition Height="*" MinHeight="200" />

                            <!--  4: 下セパレータ用通路  -->
                            <RowDefinition Height="auto" />

                            <!--  5: 下常設ツール  -->
                            <RowDefinition
                                x:Name="Row_BottomTool"
                                Height="auto"
                                MinHeight="0" />

                            <!--  6: 右端サイドバー  -->
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>


                        <Grid.ColumnDefinitions>
                            <!--  0: 左端サイドバー  -->
                            <ColumnDefinition Width="Auto" />

                            <!--  1: 👈左常設ツール  -->
                            <ColumnDefinition
                                x:Name="Col_LeftTool"
                                Width="Auto"
                                MinWidth="0" />


                            <!--  2: 左セパレータ用通路  -->
                            <ColumnDefinition Width="auto"/>


                            <!--  3: ★中央メイン領域  -->
                            <ColumnDefinition  MinWidth="200" >
                                <ColumnDefinition.Style>
                                    <Style TargetType="ColumnDefinition">
                                        <Setter Property="Width" Value="*" />


                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RightToolPain.IsContentVisible , RelativeSource={RelativeSource TemplatedParent}}" Value="true ">
                                                <Setter Property="Width" Value="*" />

                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ColumnDefinition.Style>

                            </ColumnDefinition>

                            <!--  4: 右セパレータ用通路  -->
                            <ColumnDefinition Width="auto" >
                   

                            </ColumnDefinition>
                            <!--  5: 👉右常設ツール  -->
                            <ColumnDefinition
                                x:Name="Col_RightTool"
                                 MinWidth="0" >

                                <ColumnDefinition.Style>
                                    <Style TargetType="ColumnDefinition">
                                        <Setter Property="Width" Value="auto" />
                                        

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RightToolPain.IsContentVisible , RelativeSource={RelativeSource TemplatedParent}}" Value="false ">
                                                <Setter Property="Width" Value="0" />

                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ColumnDefinition.Style>

                            </ColumnDefinition>

                            <!--  6: 右端サイドバー  -->
                            <ColumnDefinition Width="auto" />

                        </Grid.ColumnDefinitions>




                        <!--  📦 列2：中央メイン領域（4画面自由分割ツリー）  -->
                        <ContentPresenter
                            x:Name="PART_MainContent"
                            Grid.Row="3"
                            Grid.Column="3"
                            Content="{Binding RootDocumentNode, RelativeSource={RelativeSource TemplatedParent}}" />

                        <Grid
                            x:Name="PART_IndicatorOuter"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Panel.ZIndex="9999"
                            Background="Transparent"
                            IsHitTestVisible="False"
                            Visibility="Collapsed">


                            <Border
                                x:Name="PART_IndicatorOuterTop"
                                Width="24"
                                Height="24"
                                Margin="0,4,0,0"
                                VerticalAlignment="Top"
                                AllowDrop="True"
                                Background="#FF2D2D30"
                                BorderBrush="#FF007ACC"
                                BorderThickness="1"
                                CornerRadius="2">
                                <Rectangle
                                    Width="14"
                                    Height="6"
                                    Margin="0,3,0,0"
                                    VerticalAlignment="Top"
                                    Fill="#FF007ACC" />
                            </Border>
                            <Border
                                x:Name="PART_IndicatorOuterBottom"
                                Width="24"
                                Height="24"
                                Margin="0,0,0,4"
                                VerticalAlignment="Bottom"
                                AllowDrop="True"
                                Background="#FF2D2D30"
                                BorderBrush="#FF007ACC"
                                BorderThickness="1"
                                CornerRadius="2">
                                <Rectangle
                                    Width="14"
                                    Height="6"
                                    Margin="0,0,0,3"
                                    VerticalAlignment="Bottom"
                                    Fill="#FF007ACC" />
                            </Border>
                            <Border
                                x:Name="PART_IndicatorOuterLeft"
                                Width="24"
                                Height="24"
                                Margin="4,0,0,0"
                                HorizontalAlignment="Left"
                                AllowDrop="True"
                                Background="#FF2D2D30"
                                BorderBrush="#FF007ACC"
                                BorderThickness="1"
                                CornerRadius="2">
                                <Rectangle
                                    Width="6"
                                    Height="14"
                                    Margin="3,0,0,0"
                                    HorizontalAlignment="Left"
                                    Fill="#FF007ACC" />
                            </Border>
                            <Border
                                x:Name="PART_IndicatorOuterRight"
                                Width="24"
                                Height="24"
                                Margin="0,0,4,0"
                                HorizontalAlignment="Right"
                                AllowDrop="True"
                                Background="#FF2D2D30"
                                BorderBrush="#FF007ACC"
                                BorderThickness="1"
                                CornerRadius="2"
                                IsHitTestVisible="True">

                                <Rectangle
                                    Width="6"
                                    Height="14"
                                    Margin="0,0,3,0"
                                    HorizontalAlignment="Right"
                                    Fill="#FF007ACC" />
                            </Border>
                        </Grid>


                        <TextBlock x:Name="XXX"
                                   Grid.Column="0"                                   
                                   >
                        </TextBlock>


                        <TextBlock x:Name="YYY"
                                   Grid.Column="1"                                   
                                   >
                        </TextBlock>
                        
                        <!--  👈 左常設エリア  -->
                        <ContentPresenter
                            x:Name="PART_LeftContent"
                            Grid.Row="3"
                            Grid.RowSpan="1"
                            Grid.Column="1"
                            Content="{Binding LeftToolPain .BasePane, RelativeSource={RelativeSource TemplatedParent}}">
                            <ContentPresenter.Resources>

                                <DataTemplate DataType="{x:Type models:PaneContentNode}">
                                    <local:DockingPane Content="{Binding}" DataContext="{Binding}" />
                                </DataTemplate>
                            </ContentPresenter.Resources>
                            <!--  ⚡ [全自動緊縮]：データが null の時は、250pxのマス目ごと物理的に 0px へ完全消滅させます  -->
                            <ContentPresenter.Style>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Visibility" Value="Collapsed" />

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LeftToolPain.IsContentVisible, RelativeSource={RelativeSource TemplatedParent}}" Value="true">
                                            <Setter Property="Visibility" Value="Visible" />

                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentPresenter.Style>
                        </ContentPresenter>

                        <!--  👈 左ヘッダーエリア  -->
                        <ItemsControl
                            x:Name="PART_LeftAutoHiddenHedder"
                            Grid.Row="1"
                            Grid.RowSpan="7"
                            Grid.Column="0"
                            Width="Auto"
                            Panel.ZIndex="10000"
                            Background="#FF2D2D30"
                            BorderBrush="#FF3F3F46"
                            BorderThickness="1,0,0,0"
                            ItemsSource="{Binding LeftToolPain.HiddenPanes, RelativeSource={RelativeSource TemplatedParent}}"
                            Visibility="Visible">
                            
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Visible" />

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LeftToolPain.IsContentVisible  , RelativeSource={RelativeSource TemplatedParent}}" Value="false">
                                            <Setter Property="Visibility" Value="Collapsed" />

                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            
                            <!--  タブボタンを「上から下」へ縦に並べるパネル  -->
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Margin="0,10,0,0" Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <!--  🎯 VSそっくりの「縦書きタブボタン」のデザイン  -->
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton
                                        x:Name="LeftHiddenTabBorder"
                                        Margin="0,0,0,5"
                                        Padding="6,12,6,12"
                                        Background="Transparent"
                                        IsChecked="{Binding IsAutoHidden, Mode=TwoWay}">

                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#FFDCDCDC"
                                            Text="{Binding SelectedTab.Title}">
                                            <TextBlock.LayoutTransform>
                                                <RotateTransform Angle="90" />
                                            </TextBlock.LayoutTransform>
                                        </TextBlock>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--  👈 左スプリッターエリア  -->
                        <GridSplitter
                            x:Name="PART_LeftSplitter"
                            Grid.Row="3"
                            Grid.RowSpan="1"
                            Grid.Column="2"
                            Width="12"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Background="#FF3E3E42"
                             >

                            <GridSplitter.Style>
                                <Style TargetType="GridSplitter">
                                    <Setter Property="Visibility" Value="Visible" />
         
                                    <Style.Triggers> 
                                        <DataTrigger Binding="{Binding LeftToolPain.IsContentVisible  , RelativeSource={RelativeSource TemplatedParent}}" Value="false">
                                            <Setter Property="Visibility" Value="Collapsed" />

                                        </DataTrigger>

                                    </Style.Triggers>
                                </Style>
                            </GridSplitter.Style>


                        </GridSplitter>


                        <!--  👈 左隠しエリア  -->
                        <Grid x:Name="PART_LeftOverlayPaneNode"
                            Grid.Row="3"
                            Grid.Column="1"
                            Grid.ColumnSpan="3"
                            Width="300"
                            HorizontalAlignment="Left"
                            Panel.ZIndex="50000"
                              
                                >
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LeftToolPain.OverlayPaneNode.IsAutoHidden , RelativeSource={RelativeSource TemplatedParent}}" Value="false">
                                            <Setter Property="Visibility" Value="Visible" />

                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <GridSplitter
                                Grid.Column="1"
                                Width="12"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Background="#FF3E3E42"
                            >
                               
                            </GridSplitter>

                            <!--<TextBlock Grid.Column="0" Background="Red"/>-->
                            <ContentPresenter
                                x:Name="PART_LeftOverlayContent"
                                Grid.Column="0"
                                Panel.ZIndex="50000" 
                                Content="{Binding LeftToolPain.OverlayPaneNode, RelativeSource={RelativeSource TemplatedParent}}">

                                <ContentPresenter.ContentTemplate>
                                    <DataTemplate DataType="{x:Type models:PaneContentNode}">
                                        <local:DockingPane Content="{Binding}" DataContext="{Binding}" />
                                    </DataTemplate>
                                </ContentPresenter.ContentTemplate>

                            </ContentPresenter>

                        </Grid>

                        <!--  👉 右常設エリア  -->
                        <ContentPresenter
                            x:Name="PART_RightContent"
                            Grid.Row="3"
                            Grid.RowSpan="1"
                            Grid.Column="5"
                            Content="{Binding RightToolPain.BasePane, RelativeSource={RelativeSource TemplatedParent}}">
                            <ContentPresenter.Resources>
                                <DataTemplate DataType="{x:Type models:PaneContentNode}">
                                    <local:DockingPane Content="{Binding}" DataContext="{Binding}" />
                                </DataTemplate>
                            </ContentPresenter.Resources>
                            <ContentPresenter.Style>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Visibility" Value="Collapsed" />

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RightToolPain.IsContentVisible ,RelativeSource={RelativeSource TemplatedParent}}" Value="true">
                                            <Setter Property="Visibility" Value="Visible" />

                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentPresenter.Style>
                        </ContentPresenter>

                        <!--  👉 右ヘッダーエリア  -->
                        <ItemsControl
                            x:Name="PART_RightAutoHiddenHedder"
                            Grid.Row="1"
                            Grid.RowSpan="7"
                            Grid.Column="6"
                            Width="Auto"
                            Panel.ZIndex="10000"
                            Background="#FF2D2D30"
                            BorderBrush="#FF3F3F46"
                            BorderThickness="1,0,0,0"
                            ItemsSource="{Binding RightToolPain.HiddenPanes, RelativeSource={RelativeSource TemplatedParent}}">

                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Visible" />

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RightToolPain.IsContentVisible , RelativeSource={RelativeSource TemplatedParent}}" Value="false ">
                                            <Setter Property="Visibility" Value="Visible" />

                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>

                            <!--  タブボタンを「上から下」へ縦に並べるパネル  -->
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Margin="0,10,0,0" Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <!--  🎯 VSそっくりの「縦書きタブボタン」のデザイン  -->
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton
                                        x:Name="RightHiddenTabBorder"
                                        Margin="0,0,0,5"
                                        Padding="6,12,6,12"
                                        Background="Transparent"
                                        IsChecked="{Binding IsAutoHidden, Mode=TwoWay}">


                                        <!--  文字列（タイトル）を時計回りに 90 度回転させて美しい縦書きにします  -->
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#FFDCDCDC"
                                            Text="{Binding SelectedTab.Title}">
                                            <TextBlock.LayoutTransform>
                                                <RotateTransform Angle="90" />
                                            </TextBlock.LayoutTransform>
                                        </TextBlock>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>


                        <!--  👉 右スプリッターエリア  -->
                        <GridSplitter
                            x:Name="PART_RightSplitter"
                            Grid.Row="3"
                            Grid.RowSpan="1"
                            Grid.Column="4"
                            Width="12"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Background="#FF3E3E42">


                            <GridSplitter.Style>
                                <Style TargetType="GridSplitter">
                                    <Setter Property="Visibility" Value="Visible" />

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RightToolPain.IsContentVisible ,RelativeSource={RelativeSource TemplatedParent}}" Value="false">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </GridSplitter.Style>
                        </GridSplitter>

                        <!--  👉 右隠しエリア  -->
                        <Grid x:Name="PART_RightOverlayPaneNode" 
                            Grid.Row="3"
                            Grid.Column="3"
                            Grid.ColumnSpan="1"
                            Width="300"
                            HorizontalAlignment="Right"
                            Panel.ZIndex="50000"
                              >
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RightToolPain.OverlayPaneNode.IsAutoHidden , RelativeSource={RelativeSource TemplatedParent}}" Value="false">
                                            <Setter Property="Visibility" Value="Visible"  />

                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <GridSplitter x:Name="PART_RightHiddenPainSpitter"
                                Grid.Column="1"
                                Width="12"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Background="#FF3E3E42"
                                >
                                 
                            </GridSplitter>

                            <!--<TextBlock Text="hogehoe"   Foreground="Wheat"          Background="Transparent"                     Grid.Column="2"
>
                                
                            </TextBlock>-->


                            <ContentPresenter  
                                x:Name="PART_RightOverlayContent"
                                Grid.Column="2"
                                Grid.ColumnSpan="3"
                                Panel.ZIndex="150000"
                                 Content="{Binding RightToolPain .OverlayPaneNode, RelativeSource={RelativeSource TemplatedParent}}">

                                <ContentPresenter.ContentTemplate >
                                    <DataTemplate DataType="{x:Type Interfaces:IPaneNode}">
                                        <local:DockingPane Content="{Binding}" DataContext="{Binding}" />
                                    </DataTemplate>
                                </ContentPresenter.ContentTemplate>

                            </ContentPresenter>

                        </Grid>




                        <!--  👆 上常設エリア  -->
                        <ContentPresenter
                            x:Name="PART_TopContent"
                            Grid.Row="1"
                            Grid.Column="1"
                            Grid.ColumnSpan="5"
                            Content="{Binding TopToolPain.BasePane , RelativeSource={RelativeSource TemplatedParent}}">
                            <ContentPresenter.Resources>
                                <DataTemplate DataType="{x:Type models:PaneContentNode}">
                                    <local:DockingPane Content="{Binding}" DataContext="{Binding}" />
                                </DataTemplate>
                            </ContentPresenter.Resources>
                            <ContentPresenter.Style>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Visibility" Value="Collapsed" />

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TopToolPain.IsContentVisible ,RelativeSource={RelativeSource TemplatedParent}}" Value="true">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentPresenter.Style>

                        </ContentPresenter>


                        <!--  👆 上ヘッダーエリア  -->
                        <ItemsControl
                            x:Name="PART_TopAutoHiddenHedder"
                            Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="7"
                            Height ="Auto"
                            Panel.ZIndex="10000"
                            Background="#FF2D2D30"
                            BorderBrush="#FF3F3F46"
                            BorderThickness="1,0,0,0"
                           
                            ItemsSource="{Binding TopToolPain.HiddenPanes, RelativeSource={RelativeSource TemplatedParent}}">

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Collapsed" />

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TopToolPain.IsContentVisible , RelativeSource={RelativeSource TemplatedParent}}" Value="false ">
                                            <Setter Property="Visibility" Value="Visible" />

                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <!--  🎯 VSそっくりの「縦書きタブボタン」のデザイン  -->
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton
                                        x:Name="TopHiddenTabBorder"
                                        Margin="0,0,0,0"
                                        Padding="6,12,6,12"
                                        Background="Transparent"
                                        IsChecked="{Binding IsAutoHidden, Mode=TwoWay}">

                                        <!--  文字列（タイトル）を時計回りに 90 度回転させて美しい縦書きにします  -->
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#FFDCDCDC"
                                            Text="{Binding SelectedTab.Title}" />
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                     

                        </ItemsControl>
                        <!--  👆 上スプリッターエリア  -->
                        <GridSplitter
                            x:Name="PART_TopSplitter"
                            Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="7"
                            Height="12"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Background="#FF3E3E42"
                              >
                            <GridSplitter.Style>
                                <Style TargetType="GridSplitter">
                                    <Setter Property="Visibility" Value="Visible" />

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TopToolPain.IsContentVisible , RelativeSource={RelativeSource TemplatedParent}}" Value="false">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </GridSplitter.Style>
                        </GridSplitter>



                        <!--  👆 上隠しエリア  -->
                        <Grid
                            Grid.Row="1"
                            Grid.RowSpan="3"
                            Grid.Column="0"
                            Grid.ColumnSpan="7"
                            Height="300"
                            VerticalAlignment="Top"
                            Panel.ZIndex="50000">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>


                                        <DataTrigger Binding="{Binding TopToolPain.OverlayPaneNode.IsAutoHidden , RelativeSource={RelativeSource TemplatedParent}}" Value="false">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                 
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <GridSplitter
                                x:Name="hoge"
                                Grid.Row="1"
                                Height="12"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Background="#FF3E3E42"
                                Visibility="Visible" />

                            <ContentPresenter
                                x:Name="PART_TopOverlayContent"
                                Grid.Row="0"
                                Panel.ZIndex="50000"
                                 Content="{Binding TopToolPain .OverlayPaneNode, RelativeSource={RelativeSource TemplatedParent}}">

                                <ContentPresenter.ContentTemplate>
                                    <DataTemplate DataType="{x:Type Interfaces:IPaneNode}">
                                        <local:DockingPane Content="{Binding}" DataContext="{Binding}" />
                                    </DataTemplate>
                                </ContentPresenter.ContentTemplate>

                            </ContentPresenter>
                            
                        </Grid>


                        <!--  👇 下常設エリア  -->
                        <ContentPresenter
                            x:Name="PART_BottomContent"
                            Grid.Row="5"
                            Grid.Column="1"
                            Grid.ColumnSpan="5"
                            Content="{Binding BottomToolPain.BasePane, RelativeSource={RelativeSource TemplatedParent}}">
                            <ContentPresenter.Resources>
                                <DataTemplate DataType="{x:Type models:PaneContentNode}">
                                    <local:DockingPane Content="{Binding}" DataContext="{Binding}" />
                                </DataTemplate>
                            </ContentPresenter.Resources>
                            <ContentPresenter.Style>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Visibility" Value="Visible" />

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BottomToolPain.IsContentVisible , RelativeSource={RelativeSource AncestorType={x:Type viewModels:DockingPaneViewModel}}}" Value="false">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentPresenter.Style>
                        </ContentPresenter>

                        <!--  👇 下スプリッターエリア  -->
                        <GridSplitter
                            x:Name="PART_BottomSplitter"
                            Grid.Row="4"
                            Grid.Column="0"
                            Grid.ColumnSpan="7"
                            Height="12"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Background="#FF3E3E42"
                             >

                            <GridSplitter.Style>
                                <Style TargetType="GridSplitter">
                                    <Setter Property="Visibility" Value="Visible" />

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BottomToolPain.IsContentVisible , RelativeSource={RelativeSource TemplatedParent}}" Value="false">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </GridSplitter.Style>
                        </GridSplitter>

                        <!--  👇 下ヘッダーエリア  -->
                        <ItemsControl
                            Grid.Row="6"
                            Grid.Column="0"
                            Grid.ColumnSpan="7"
                            Width="Auto"
                            Panel.ZIndex="10000"
                            Background="#FF2D2D30"
                            BorderBrush="#FF3F3F46"
                            BorderThickness="1,0,0,0"
                            ItemsSource="{Binding BottomToolPain.HiddenPanes , RelativeSource={RelativeSource TemplatedParent}}">
                            <!--  何よりも手前に配置  -->

                            <!--  タブボタンを「上から下」へ縦に並べるパネル  -->
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <!--  🎯 VSそっくりの「縦書きタブボタン」のデザイン  -->
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton
                                        x:Name="BottomHiddenTabBorder"
                                        Margin="0,0,0,5"
                                        Padding="6,12,6,12"
                                        Background="Transparent"
                                        IsChecked="{Binding IsAutoHidden, Mode=TwoWay}">

                                        <!--  文字列（タイトル）を時計回りに 90 度回転させて美しい縦書きにします  -->
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#FFDCDCDC"
                                            Text="{Binding SelectedTab.Title}" />
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>


                        <!--  👇 下隠しエリア  -->
                        <Grid
                            Grid.Row="5"
                            Grid.Column="3"
                            Grid.ColumnSpan="3"
                            Width="300"
                            VerticalAlignment="Bottom"
                            Panel.ZIndex="50000">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BottomOverlayPaneNode.IsPinned}" Value="false">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding BottomOverlayPaneNode.IsAutoHidden}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <GridSplitter
                                Grid.Column="1"
                                Width="12"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Background="#FF3E3E42"
                                Visibility="Visible" />

                            <ContentPresenter
                                x:Name="PART_BottomOverlayContent"
                                Grid.Column="0"
                                Panel.ZIndex="50000"
                                Content="{Binding BottomOverlayPaneNode}">

                                <ContentPresenter.ContentTemplate>
                                    <DataTemplate DataType="{x:Type models:PaneContentNode}">
                                        <local:DockingPane Content="{Binding}" DataContext="{Binding}" />
                                    </DataTemplate>
                                </ContentPresenter.ContentTemplate>

                            </ContentPresenter>

                        </Grid>


                    </Grid>
                    
                    <!--<ControlTemplate.Triggers>

                        --><!--  =========================================================================  -->
                        <!--  👉 【右エリア】の自動消滅＆緊縮トリガー  -->
                        <!--  =========================================================================  -->
                        <!--  💡 条件1: そもそも右側のデータ（RightToolRoot）が空っぽの時  --><!--
                        <DataTrigger Binding="{Binding RightToolRoot}" Value="{x:Null}">
                            <Setter TargetName="Col_RightTool" Property="Width" Value="0" />
                            <Setter TargetName="PART_RightSplitter" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>

                        --><!--  💡 条件2: 画鋲が外されて、右エリアのツールペインが「自動隠蔽（AutoHidden）」状態になった時  -->
                        <!--
                            🎯【これぞ本物のVS風挙動！】：
                            データは裏側に残したまま、右の列幅を「0」にしてセパレータもCollapsedに追い込みます。
                            これによって黒い隙間が1ミリも残らず、中央のエディタが画面右端までググッと全自動で広がります！
                        --><!--
                        <DataTrigger Binding="{Binding RightToolRoot.IsAutoHidden}" Value="True">
                            <Setter TargetName="Col_RightTool" Property="Width" Value="0" />
                            <Setter TargetName="PART_RightSplitter" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>


                        --><!--  =========================================================================  -->
                        <!--  👈 【左エリア】の自動消滅＆緊縮トリガー  -->
                        <!--  =========================================================================  --><!--
                        <DataTrigger Binding="{Binding LeftToolRoot}" Value="{x:Null}">
                            <Setter TargetName="Col_LeftTool" Property="Width" Value="0" />
                            <Setter TargetName="PART_LeftSplitter" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding LeftToolRoot.IsAutoHidden}" Value="True">
                            <Setter TargetName="Col_LeftTool" Property="Width" Value="0" />
                            <Setter TargetName="PART_LeftSplitter" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>


                        --><!--  =========================================================================  -->
                        <!--  👆 【上エリア】の自動消滅＆緊縮トリガー  -->
                        <!--  =========================================================================  --><!--
                        <DataTrigger Binding="{Binding TopToolRoot}" Value="{x:Null}">
                            <Setter TargetName="Row_TopTool" Property="Height" Value="0" />
                            <Setter TargetName="PART_TopSplitter" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding TopToolRoot.IsAutoHidden}" Value="True">
                            <Setter TargetName="Row_TopTool" Property="Height" Value="0" />
                            <Setter TargetName="PART_TopSplitter" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>


                        --><!--  =========================================================================  -->
                        <!--  👇 【下エリア】の自動消滅＆緊縮トリガー  -->
                        <!--  =========================================================================  --><!--
                        <DataTrigger Binding="{Binding BottomToolRoot}" Value="{x:Null}">
                            <Setter TargetName="Row_BottomTool" Property="Height" Value="0" />
                            <Setter TargetName="PART_BottomSplitter" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding BottomToolRoot.IsAutoHidden}" Value="True">
                            <Setter TargetName="Row_BottomTool" Property="Height" Value="0" />
                            <Setter TargetName="PART_BottomSplitter" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>

                    </ControlTemplate.Triggers>-->

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  =========================================================================  -->
    <!--  🌲 【再帰解決エンジン】 具象クラス解決用の DataTemplate をここに配置  -->
    <!--  =========================================================================  -->
    <!--  =========================================================================  -->
    <!--  🌲 【再帰解決エンジン】 具象クラス解決用の DataTemplate  -->
    <!--  =========================================================================  -->
    <DataTemplate DataType="{x:Type models:PaneContentNode}">
        <local:DockingPane />
    </DataTemplate>



    <!--  =========================================================================  -->
    <!--  🛠️ 【UIコアエンジン】中央ツリーと右ツールペインを1インフラで共通統治  -->
    <!--  =========================================================================  -->
    <Style TargetType="{x:Type local:DockingPane}">
        <Setter Property="Background" Value="#FF1E1E1E" />
        <Setter Property="BorderBrush" Value="#FF3E3E42" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:DockingPane}">
                    <Grid Visibility="{Binding IsAutoHidden, Converter={StaticResource TrueToCollapsedConverter}}">
                        <!--  【状態②：マルチタブ実体状態（通常フォルダ ＆ ツール共通枠）】  -->
                        <Border
                            x:Name="LeafVisual"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Visibility="Collapsed">
                            <DockPanel>
                                <ItemsControl
                                    x:Name="PART_TabHeader"
                                    Background="#FF2D2D30"
                                    DockPanel.Dock="Top"
                                    ItemsSource="{Binding TabViewModels}">
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="{x:Type ItemsControl}">
                                            <Border Background="{TemplateBinding Background}" BorderThickness="0">
                                                <ScrollViewer
                                                    x:Name="PART_HeaderScrollViewer"
                                                    HorizontalScrollBarVisibility="Hidden"
                                                    VerticalScrollBarVisibility="Disabled">
                                                    <ItemsPresenter />
                                                </ScrollViewer>
                                            </Border>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                x:Name="TabItemBorder"
                                                Width="Auto"
                                                MinWidth="80"
                                                Margin="1,2,1,0"
                                                Padding="10,4,6,4"
                                                Background="#FF2D2D30"
                                                BorderBrush="#FF3E3E42"
                                                BorderThickness="1,1,1,0"
                                                CornerRadius="3,3,0,0"
                                                Cursor="Hand">

                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="20" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        FontSize="24"
                                                        Foreground="#FFDFDFDF"
                                                        Text="{Binding Title}"
                                                        ToolTip="{Binding Title}" />
                                                    <Button
                                                        x:Name="PART_TabCloseButton"
                                                        Grid.Column="1"
                                                        Width="14"
                                                        Height="14"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Arrow"
                                                        Focusable="False">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border
                                                                    x:Name="ButtonBorder"
                                                                    Background="Transparent"
                                                                    CornerRadius="2">
                                                                    <Path
                                                                        x:Name="CrossPath"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        Data="M3,3 L11,11 M11,3 L3,11"
                                                                        Stroke="#FF999999"
                                                                        StrokeThickness="1.2" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="ButtonBorder" Property="Background" Value="#FFC42B1C" />
                                                                        <Setter TargetName="CrossPath" Property="Stroke" Value="#FFFFFFFF" />
                                                                    </Trigger>

                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>


                                                    <uc:PinButton
                                                        Grid.Column="2"
                                                        Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType={x:Type local:DockingPane}}}"
                                                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type viewModels:DockingPaneViewModel}}}"
                                                        IsPinned="{Binding DataContext.IsPinned, RelativeSource={RelativeSource AncestorType={x:Type local:DockingPane}}}" />



                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid
                                    x:Name="PART_TabContentContainer"
                                    Background="#FF1E1E1E"
                                    TextBlock.Foreground="#FFDFDFDF">
                                    <ContentPresenter Content="{Binding DataContext.ActiveViewModel, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <Grid
                                        x:Name="PART_DockingIndicator"
                                        Width="120"
                                        Height="120"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                        <Ellipse
                                            Fill="#80000000"
                                            Stroke="#FF3E3E42"
                                            StrokeThickness="1" />
                                        <Grid>
                                            <Border
                                                x:Name="PART_IndicatorCenter"
                                                Width="24"
                                                Height="24"
                                                Background="#FF2D2D30"
                                                BorderBrush="#FF007ACC"
                                                BorderThickness="1"
                                                CornerRadius="2"
                                                Visibility="{Binding IsToolPane, Converter={StaticResource TrueToCollapsedConverter}}">
                                                <Rectangle
                                                    Width="12"
                                                    Height="12"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Fill="#FF007ACC" />
                                            </Border>
                                            <Border
                                                x:Name="PART_IndicatorTop"
                                                Width="24"
                                                Height="24"
                                                Margin="0,4,0,0"
                                                VerticalAlignment="Top"
                                                Background="#FF2D2D30"
                                                BorderBrush="#FF007ACC"
                                                BorderThickness="1"
                                                CornerRadius="2">
                                                <Rectangle
                                                    Width="14"
                                                    Height="6"
                                                    Margin="0,3,0,0"
                                                    VerticalAlignment="Top"
                                                    Fill="#FF007ACC" />
                                            </Border>
                                            <Border
                                                x:Name="PART_IndicatorBottom"
                                                Width="24"
                                                Height="24"
                                                Margin="0,0,0,4"
                                                VerticalAlignment="Bottom"
                                                Background="#FF2D2D30"
                                                BorderBrush="#FF007ACC"
                                                BorderThickness="1"
                                                CornerRadius="2">
                                                <Rectangle
                                                    Width="14"
                                                    Height="6"
                                                    Margin="0,0,0,3"
                                                    VerticalAlignment="Bottom"
                                                    Fill="#FF007ACC" />
                                            </Border>
                                            <Border
                                                x:Name="PART_IndicatorLeft"
                                                Width="24"
                                                Height="24"
                                                Margin="4,0,0,0"
                                                HorizontalAlignment="Left"
                                                Background="#FF2D2D30"
                                                BorderBrush="#FF007ACC"
                                                BorderThickness="1"
                                                CornerRadius="2">
                                                <Rectangle
                                                    Width="6"
                                                    Height="14"
                                                    Margin="3,0,0,0"
                                                    HorizontalAlignment="Left"
                                                    Fill="#FF007ACC" />
                                            </Border>
                                            <Border
                                                x:Name="PART_IndicatorRight"
                                                Width="24"
                                                Height="24"
                                                Margin="0,0,4,0"
                                                HorizontalAlignment="Right"
                                                Background="#FF2D2D30"
                                                BorderBrush="#FF007ACC"
                                                BorderThickness="1"
                                                CornerRadius="2">
                                                <Rectangle
                                                    Width="6"
                                                    Height="14"
                                                    Margin="0,0,3,0"
                                                    HorizontalAlignment="Right"
                                                    Fill="#FF007ACC" />
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </DockPanel>
                        </Border>


                        <Grid x:Name="PART_VerticalSplitGrid" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" Content="{Binding MainChild}" />
                            <GridSplitter
                                x:Name="PART_VerticalSplitBar"
                                Grid.Column="1"
                                Width="4"
                                HorizontalAlignment="Stretch"
                                Background="#FF3E3E42"
                                ShowsPreview="False" />
                            <ContentPresenter Grid.Column="2" Content="{Binding SubChild}" />
                            <Border
                                x:Name="PART_VerticalSplitterIndicator"
                                Grid.Column="1"
                                Width="48"
                                Margin="-22,0,-22,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Stretch"
                                Background="#440000CC"
                                BorderBrush="#FF007ACC"
                                BorderThickness="1,0,1,0"
                                IsHitTestVisible="True"
                                Visibility="Collapsed">
                                <Border.Effect>
                                    <BlurEffect Radius="2" />
                                </Border.Effect>
                            </Border>
                        </Grid>
                        <Grid x:Name="PART_HorizontalSplitGrid" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter Grid.Row="0" Content="{Binding MainChild}" />

                            <GridSplitter
                                x:Name="PART_HorizontalSplitBar"
                                Grid.Row="1"
                                Height="4"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Background="#FF3E3E42"
                                ShowsPreview="False" />
                            <ContentPresenter Grid.Row="2" Content="{Binding SubChild}" />

                            <Border
                                x:Name="PART_HorizontalSplitterIndicator"
                                Grid.Row="1"
                                Height="48"
                                Margin="0,-22,0,-22"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Background="#440000CC"
                                BorderBrush="#FF007ACC"
                                BorderThickness="0,1,0,1"
                                IsHitTestVisible="True"
                                Visibility="Collapsed">
                                <Border.Effect>
                                    <BlurEffect Radius="2" />
                                </Border.Effect>
                            </Border>
                        </Grid>



                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="LayoutStates">
                                <VisualState x:Name="LeafState">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LeafVisual" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="VerticalState">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_VerticalSplitGrid" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="HorizontalState">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_HorizontalSplitGrid" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!--  💡 部屋のDataContext（PaneContentNode）の IsToolPane が True のとき発動  -->
                        <DataTrigger Binding="{Binding IsToolPane}" Value="True">

                            <!--  1. タブヘッダー（PART_TabHeader）を DockPanel の「下（Bottom）」に引っ越しさせる！  -->
                            <Setter TargetName="PART_TabHeader" Property="DockPanel.Dock" Value="Bottom" />

                            <!--  2. ツールウィンドウ専用の背景色と枠線に変更する（VS風の少し明るいグレー）  -->
                            <Setter Property="Background" Value="#FF2D2D30" />
                            <Setter Property="BorderBrush" Value="#FF3F3F46" />

                        </DataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsToolPane}" Value="True" />
                                <Condition Binding="{Binding IsAutoHidden}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.Setters>
                                <Setter TargetName="PART_TabHeader" Property="DockPanel.Dock" Value="Right" />
                                <Setter TargetName="PART_TabContentContainer" Property="Visibility" Value="Collapsed" />

                            </MultiDataTrigger.Setters>
                        </MultiDataTrigger>






                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>



    </Style>
</ResourceDictionary>
