<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:TokiDockingPane.Converters"
    xmlns:local="clr-namespace:TokiDockingPane"
    xmlns:models="clr-namespace:TokiDockingPane.Models"
    xmlns:sysDiag="clr-namespace:System.Diagnostics;assembly=WindowsBase"
    xmlns:uc="clr-namespace:TokiDockingPane.UserControls"
    xmlns:viewModels="clr-namespace:TokiDockingPane.ViewModels">

    <conv:DoubleToGridLengthConverter x:Key="DoubleToGridLengthConverter" />
    <conv:TrueToCollapsedConverter x:Key="TrueToCollapsedConverter" />

    <!--  =========================================================================  -->
    <!--  👑 【最外殻統治コントロール：DockingPaneViewModel の最終確定形態】  -->
    <!--  =========================================================================  -->
    <Style TargetType="{x:Type viewModels:DockingPaneViewModel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type viewModels:DockingPaneViewModel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!--  0: 上端サイドバー  -->
                            <RowDefinition Height="auto" />

                            <!--  1: 上常設ツール  -->
                            <RowDefinition
                                x:Name="Row_TopTool"
                                Height="*"
                                MinHeight="0" />
                            <!--  2: 上セパレータ用通路  -->
                            <RowDefinition Height="12" />

                            <!--  3: ★中央メイン領域  -->
                            <RowDefinition Height="*" MinHeight="200" />

                            <!--  4: 下セパレータ用通路  -->
                            <RowDefinition Height="12" />

                            <!--  5: 下常設ツール  -->
                            <RowDefinition
                                x:Name="Row_BottomTool"
                                Height="*"
                                MinHeight="0" />

                            <!--  6: 右端サイドバー  -->
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>


                        <Grid.ColumnDefinitions>
                            <!--  0: 左端サイドバー  -->
                            <ColumnDefinition Width="Auto" />

                            <!--  1: 👈左常設ツール  -->
                            <ColumnDefinition
                                x:Name="Col_LeftTool"
                                Width="*"
                                MinWidth="0" />

                            <!--  2: 左セパレータ用通路  -->
                            <ColumnDefinition Width="12" />

                            <!--  3: ★中央メイン領域  -->
                            <ColumnDefinition Width="*" MinWidth="200" />

                            <!--  4: 右セパレータ用通路  -->
                            <ColumnDefinition Width="12" />

                            <!--  5: 👉右常設ツール  -->
                            <ColumnDefinition
                                x:Name="Col_RightTool"
                                Width="Auto"
                                MinWidth="0" />

                            <!--  6: 右端サイドバー  -->
                            <ColumnDefinition Width="Auto" />

                        </Grid.ColumnDefinitions>




                        <!--  📦 列2：中央メイン領域（4画面自由分割ツリー）  -->
                        <ContentPresenter
                            x:Name="PART_MainContent"
                            Grid.Row="3"
                            Grid.Column="3"
                            Content="{Binding RootDocumentNode, RelativeSource={RelativeSource TemplatedParent}}" />

                        <Grid
                            x:Name="PART_IndicatorOuter"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Panel.ZIndex="9999"
                            Background="Transparent"
                            IsHitTestVisible="False"
                            Visibility="Collapsed">


                            <Border
                                x:Name="PART_IndicatorOuterTop"
                                Width="24"
                                Height="24"
                                Margin="0,4,0,0"
                                VerticalAlignment="Top"
                                AllowDrop="True"
                                Background="#FF2D2D30"
                                BorderBrush="#FF007ACC"
                                BorderThickness="1"
                                CornerRadius="2">
                                <Rectangle
                                    Width="14"
                                    Height="6"
                                    Margin="0,3,0,0"
                                    VerticalAlignment="Top"
                                    Fill="#FF007ACC" />
                            </Border>
                            <Border
                                x:Name="PART_IndicatorOuterBottom"
                                Width="24"
                                Height="24"
                                Margin="0,0,0,4"
                                VerticalAlignment="Bottom"
                                AllowDrop="True"
                                Background="#FF2D2D30"
                                BorderBrush="#FF007ACC"
                                BorderThickness="1"
                                CornerRadius="2">
                                <Rectangle
                                    Width="14"
                                    Height="6"
                                    Margin="0,0,0,3"
                                    VerticalAlignment="Bottom"
                                    Fill="#FF007ACC" />
                            </Border>
                            <Border
                                x:Name="PART_IndicatorOuterLeft"
                                Width="24"
                                Height="24"
                                Margin="4,0,0,0"
                                HorizontalAlignment="Left"
                                AllowDrop="True"
                                Background="#FF2D2D30"
                                BorderBrush="#FF007ACC"
                                BorderThickness="1"
                                CornerRadius="2">
                                <Rectangle
                                    Width="6"
                                    Height="14"
                                    Margin="3,0,0,0"
                                    HorizontalAlignment="Left"
                                    Fill="#FF007ACC" />
                            </Border>
                            <Border
                                x:Name="PART_IndicatorOuterRight"
                                Width="24"
                                Height="24"
                                Margin="0,0,4,0"
                                HorizontalAlignment="Right"
                                AllowDrop="True"
                                Background="#FF2D2D30"
                                BorderBrush="#FF007ACC"
                                BorderThickness="1"
                                CornerRadius="2"
                                IsHitTestVisible="True">

                                <Rectangle
                                    Width="6"
                                    Height="14"
                                    Margin="0,0,3,0"
                                    HorizontalAlignment="Right"
                                    Fill="#FF007ACC" />
                            </Border>
                        </Grid>




                        <!--  👈 左常設エリア  -->
                        <ContentPresenter
                            x:Name="PART_LeftContent"
                            Grid.Row="3"
                            Grid.RowSpan="1"
                            Grid.Column="1"
                            Content="{Binding LeftToolRoot, RelativeSource={RelativeSource TemplatedParent}}">
                            <ContentPresenter.Resources>
                                <!--
                                    💡 解決の核心：WPFが最も得意とする「型バインディング」を利用します。
                                    PaneContentNode というデータ型を検知した瞬間、WPF標準の最速レンダリングで
                                    本物の DockingPane を裏側から安全に100%確実に具現化（ぶら下げ）させます！
                                -->
                                <DataTemplate DataType="{x:Type models:PaneContentNode}">
                                    <local:DockingPane Content="{Binding}" DataContext="{Binding}" />
                                </DataTemplate>
                            </ContentPresenter.Resources>
                            <!--  ⚡ [全自動緊縮]：データが null の時は、250pxのマス目ごと物理的に 0px へ完全消滅させます  -->
                            <ContentPresenter.Style>
                                <Style TargetType="ContentPresenter">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LeftToolRoot, RelativeSource={RelativeSource AncestorType={x:Type viewModels:DockingPaneViewModel}}}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentPresenter.Style>
                        </ContentPresenter>


                        <GridSplitter
                            x:Name="PART_LeftSplitter"
                            Grid.Row="3"
                            Grid.RowSpan="1"
                            Grid.Column="2"
                            Width="12"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Background="#FF3E3E42"
                            Visibility="Visible" />

                        <ItemsControl
                            Grid.Row="0"
                            Grid.RowSpan="7"
                            Grid.Column="0"
                            Width="Auto"
                            Panel.ZIndex="10000"
                            Background="#FF2D2D30"
                            BorderBrush="#FF3F3F46"
                            BorderThickness="1,0,0,0"
                            ItemsSource="{Binding LeftHiddenPanes, RelativeSource={RelativeSource TemplatedParent}}">
                            <!--  何よりも手前に配置  -->

                            <!--  タブボタンを「上から下」へ縦に並べるパネル  -->
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Margin="0,10,0,0" Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <!--  🎯 VSそっくりの「縦書きタブボタン」のデザイン  -->
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        x:Name="HiddenTabBorder"
                                        Margin="0,0,0,5"
                                        Padding="6,12,6,12"
                                        Background="Transparent"
                                        Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding
                                                Command="{Binding DataContext.ToggleOverlayCommand, RelativeSource={RelativeSource AncestorType={x:Type viewModels:DockingPaneViewModel}}}"
                                                CommandParameter="{Binding}"
                                                MouseAction="LeftClick" />
                                        </Border.InputBindings>

                                        <!--  文字列（タイトル）を時計回りに 90 度回転させて美しい縦書きにします  -->
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#FFDCDCDC"
                                            Text="{Binding SelectedTab.Title}">
                                            <TextBlock.LayoutTransform>
                                                <RotateTransform Angle="90" />
                                            </TextBlock.LayoutTransform>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>


                        <!--  👉 右常設エリア  -->
                        <ContentPresenter
                            x:Name="PART_RightContent"
                            Grid.Row="3"
                            Grid.RowSpan="1"
                            Grid.Column="5"
                            Content="{Binding RightToolRoot, RelativeSource={RelativeSource TemplatedParent}}"
                             >
                            <ContentPresenter.Resources>
                                <DataTemplate DataType="{x:Type models:PaneContentNode}">
                                    <local:DockingPane Content="{Binding}" DataContext="{Binding}" />
                                </DataTemplate>
                            </ContentPresenter.Resources>
                            <ContentPresenter.Style>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Visibility" Value="Visible" />
 
                                    <Style.Triggers>
                                        <DataTrigger 
                                            Binding="{Binding RightToolRoot.IsPinned, 
                                            RelativeSource={RelativeSource TemplatedParent}}" 
                                            Value="false">
                                            <Setter Property="Visibility" Value="Collapsed" />
 
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentPresenter.Style>
                        </ContentPresenter>


                        <!-- ⭕ Generic.xaml : 7行×7列Gridの直下（</Grid>の直前）に追記 -->

                        <!--  🌟 右端 AutoHidden 専用サイドバー（タブヘッダー領域）  -->
                        <!--  💡 隠れているツールが 1 つ以上あるときだけ、画面の本当の右端に自動で出現します  -->
                   
                            
                        <ItemsControl
                              x:Name="PART_RightAutoHiddenHedder"
  Grid.Row="0"
  Grid.RowSpan="7"
  Grid.Column="6"
  Width="Auto"
                              Panel.ZIndex="10000"

                            Background="#FF2D2D30"
                            BorderBrush="#FF3F3F46"
                            BorderThickness="1,0,0,0"
                            ItemsSource="{Binding RightHiddenPanes, RelativeSource={RelativeSource TemplatedParent}}"
                            Visibility="Visible">

                            <!--  タブボタンを「上から下」へ縦に並べるパネル  -->
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Margin="0,10,0,0" Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <!--  🎯 VSそっくりの「縦書きタブボタン」のデザイン  -->
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        x:Name="HiddenTabBorder"
                                        Margin="0,0,0,5"
                                        Padding="6,12,6,12"
                                        Background="Transparent"
                                        Cursor="Hand">
                                        <Border.InputBindings>
                                            <!--  ポチッとクリックされたら、一時展開用のコマンドを叩く  -->
                                            <MouseBinding
                                                Command="{Binding DataContext.ToggleOverlayCommand, RelativeSource={RelativeSource AncestorType={x:Type viewModels:DockingPaneViewModel}}}"
                                                CommandParameter="{Binding}"
                                                MouseAction="LeftClick" />
                                        </Border.InputBindings>

                                        <!--  文字列（タイトル）を時計回りに 90 度回転させて美しい縦書きにします  -->
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#FFDCDCDC"
                                            Text="{Binding SelectedTab.Title}">
                                            <TextBlock.LayoutTransform>
                                                <RotateTransform Angle="90" />
                                            </TextBlock.LayoutTransform>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>



                        <GridSplitter
                            x:Name="PART_RightSplitter"
                            Grid.Row="3"
                            Grid.RowSpan="1"
                            Grid.Column="4"
                            Width="12"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Background="#FF3E3E42"
                          >


                            <GridSplitter.Style>
                                <Style TargetType="GridSplitter">
                                    <Setter Property="Visibility" Value="Visible" />

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RightToolRoot.IsPinned, RelativeSource={RelativeSource TemplatedParent}}" Value="false">
                                            <Setter Property="Visibility" Value="Collapsed" />

                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </GridSplitter.Style>
                        </GridSplitter>



                        <!--<TextBlock
                            Grid.Row="3"
                            Grid.Column="3"
                            Grid.ColumnSpan="2"
                            Width="250"
                            Panel.ZIndex="50000"
                            Text="hoge">

                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Setter Property="Background" Value="Red" />
                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding OverlayPaneNode.IsAutoHidden}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Setter Property="Background" Value="YellowGreen" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>

                        </TextBlock>-->





                        <!--<ContentPresenter
                            x:Name="PART_RightOverlayContent"
                            Grid.Row="3"
                            Grid.Column="3"
                            Grid.ColumnSpan="3"
                            Width="250"
                            HorizontalAlignment="Right"
                            Panel.ZIndex="50000"
                            Content="{Binding OverlayPaneNode, RelativeSource={RelativeSource TemplatedParent}}">

                            <ContentPresenter.ContentTemplate>
                                <DataTemplate DataType="{x:Type models:PaneContentNode}">
                                    <local:DockingPane Content="{Binding}" DataContext="{Binding}" />
                                </DataTemplate>
                            </ContentPresenter.ContentTemplate>

                            <ContentPresenter.Style>
                                <Style TargetType="ContentPresenter">
                                     <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                         
                                        <DataTrigger Binding="{Binding OverlayPaneNode.IsAutoHidden}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentPresenter.Style>
                        </ContentPresenter>-->

                        <Popup x:Name="PART_RightOverlayPopup"
       
                            PlacementTarget="{Binding ElementName=PART_RightContent}" 
       Placement="Left"
       HorizontalOffset="-250"
                          
                            IsOpen="{Binding OverlayPaneNode.IsAutoHidden }"

                          
                            StaysOpen="False"
       AllowsTransparency="True"
       PopupAnimation="Slide">
                            <!-- 開閉時にVSのような滑らかなスライド演出を付与 -->

                            <!-- 🎯 250px の部屋（local:DockingPane）を浮かび上がらせる設計図 -->
                            <Border Width="250" Height="400" Background="#FF1E1E1E" BorderBrush="#FF3E3E42" BorderThickness="1">
                                <ContentControl Content="{Binding OverlayPaneNode, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate DataType="{x:Type models:PaneContentNode}">
                                            <local:DockingPane Content="{Binding}" DataContext="{Binding}" />
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                            </Border>
                        </Popup>



                        <ContentPresenter
                            x:Name="PART_TopContent"
                            Grid.Row="1"
                            Grid.Column="1"
                            Grid.ColumnSpan="5"
                            Content="{Binding TopToolRoot, RelativeSource={RelativeSource TemplatedParent}}" />






                        <GridSplitter
                            x:Name="PART_TopSplitter"
                            Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="7"
                            Height="12"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Background="#FF3E3E42"
                            Visibility="Visible" />

                        <ItemsControl
                            Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="7"
                            Width="Auto"
                            Panel.ZIndex="10000"
                            Background="#FF2D2D30"
                            BorderBrush="#FF3F3F46"
                            BorderThickness="1,0,0,0"
                            ItemsSource="{Binding TopHiddenPanes, RelativeSource={RelativeSource TemplatedParent}}">
                            <!--  何よりも手前に配置  -->

                            <!--  タブボタンを「上から下」へ縦に並べるパネル  -->
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <!--  🎯 VSそっくりの「縦書きタブボタン」のデザイン  -->
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        x:Name="HiddenTabBorder"
                                        Margin="0,0,0,5"
                                        Padding="6,12,6,12"
                                        Background="Transparent"
                                        Cursor="Hand">
                                        <Border.InputBindings>
                                            <!--  ポチッとクリックされたら、一時展開用のコマンドを叩く  -->
                                            <MouseBinding
                                                Command="{Binding DataContext.ToggleOverlayCommand, RelativeSource={RelativeSource AncestorType={x:Type viewModels:DockingPaneViewModel}}}"
                                                CommandParameter="{Binding}"
                                                MouseAction="RightClick" />
                                        </Border.InputBindings>

                                        <!--  文字列（タイトル）を時計回りに 90 度回転させて美しい縦書きにします  -->
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#FFDCDCDC"
                                            Text="{Binding SelectedTab.Title}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>









                        <GridSplitter
                            x:Name="PART_BottomSplitter"
                            Grid.Row="4"
                            Grid.Column="0"
                            Grid.ColumnSpan="7"
                            Height="12"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Background="#FF3E3E42"
                            Visibility="Visible" />


                        <ContentPresenter
                            x:Name="PART_BottomContent"
                            Grid.Row="5"
                            Grid.Column="1"
                            Grid.ColumnSpan="5"
                            Content="{Binding BottomToolRoot, RelativeSource={RelativeSource TemplatedParent}}">
                            <ContentPresenter.Resources>
                                <DataTemplate DataType="{x:Type models:PaneContentNode}">
                                    <local:DockingPane Content="{Binding}" DataContext="{Binding}" />
                                </DataTemplate>
                            </ContentPresenter.Resources>
                            <ContentPresenter.Style>
                                <Style TargetType="ContentPresenter">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BottomToolRoot, RelativeSource={RelativeSource AncestorType={x:Type viewModels:DockingPaneViewModel}}}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentPresenter.Style>
                        </ContentPresenter>

                        <ItemsControl
                            Grid.Row="6"
                            Grid.Column="0"
                            Grid.ColumnSpan="7"
                            Width="Auto"
                            Panel.ZIndex="10000"
                            Background="#FF2D2D30"
                            BorderBrush="#FF3F3F46"
                            BorderThickness="1,0,0,0"
                            ItemsSource="{Binding BottomHiddenPanes, RelativeSource={RelativeSource TemplatedParent}}">
                            <!--  何よりも手前に配置  -->

                            <!--  タブボタンを「上から下」へ縦に並べるパネル  -->
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <!--  🎯 VSそっくりの「縦書きタブボタン」のデザイン  -->
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="20" />
                                            <RowDefinition Height="80" />
                                        </Grid.RowDefinitions>
                                        <Border
                                            x:Name="HiddenTabBorder"
                                            Grid.Row="0"
                                            Margin="0,0,0,5"
                                            Padding="6,12,6,12"
                                            Background="Transparent"
                                            Cursor="Hand">

                                            <Border.InputBindings>
                                                <!--  ポチッとクリックされたら、一時展開用のコマンドを叩く  -->
                                                <MouseBinding
                                                    Command="{Binding DataContext.ToggleOverlayCommand, RelativeSource={RelativeSource AncestorType={x:Type viewModels:DockingPaneViewModel}}}"
                                                    CommandParameter="{Binding}"
                                                    MouseAction="RightClick" />
                                            </Border.InputBindings>


                                        </Border>


                                        <!--  文字列（タイトル）を時計回りに 90 度回転させて美しい縦書きにします  -->
                                        <TextBlock
                                            Grid.Row="1"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#FFDCDCDC"
                                            Text="{Binding SelectedTab.Title}" />


                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>




                        <!--  👈 左端サイドバー (Column 0, 全行縦断)  -->
                        <ItemsControl
                            Grid.Row="0"
                            Grid.RowSpan="5"
                            Grid.Column="0"
                            Width="Auto"
                            Background="#FF2D2D30"
                            BorderBrush="#FF3F3F46"
                            BorderThickness="0,0,1,0"
                            ItemsSource="{Binding LeftHiddenPanes, RelativeSource={RelativeSource TemplatedParent}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Margin="0,10,0,0" Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,0,5"
                                        Padding="6,12,6,12"
                                        Background="Transparent"
                                        Cursor="Hand">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="#FFDCDCDC"
                                            Text="{Binding SelectedTab.Title}">
                                            <TextBlock.LayoutTransform>
                                                <RotateTransform Angle="270" />
                                                <!--  左側は270度で見やすく  -->
                                            </TextBlock.LayoutTransform>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--  👆 上端サイドバー (Row 0, 横並び、Column 1〜3まで横断)  -->
                        <ItemsControl
                            Grid.Row="0"
                            Grid.Column="1"
                            Grid.ColumnSpan="3"
                            Height="Auto"
                            Background="#FF2D2D30"
                            BorderBrush="#FF3F3F46"
                            BorderThickness="0,0,0,1"
                            ItemsSource="{Binding TopHiddenPanes, RelativeSource={RelativeSource TemplatedParent}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Margin="10,0,0,0" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,5,0"
                                        Padding="12,6,12,6"
                                        Background="Transparent"
                                        Cursor="Hand">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="#FFDCDCDC"
                                            Text="{Binding SelectedTab.Title}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>



                    </Grid>
                    <ControlTemplate.Triggers>

                        <!--  =========================================================================  -->
                        <!--  👉 【右エリア】の自動消滅＆緊縮トリガー  -->
                        <!--  =========================================================================  -->
                        <!--  💡 条件1: そもそも右側のデータ（RightToolRoot）が空っぽの時  -->
                        <DataTrigger Binding="{Binding RightToolRoot}" Value="{x:Null}">
                            <Setter TargetName="Col_RightTool" Property="Width" Value="0" />
                            <Setter TargetName="PART_RightSplitter" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>

                        <!--  💡 条件2: 画鋲が外されて、右エリアのツールペインが「自動隠蔽（AutoHidden）」状態になった時  -->
                        <!--
                            🎯【これぞ本物のVS風挙動！】：
                            データは裏側に残したまま、右の列幅を「0」にしてセパレータもCollapsedに追い込みます。
                            これによって黒い隙間が1ミリも残らず、中央のエディタが画面右端までググッと全自動で広がります！
                        -->
                        <DataTrigger Binding="{Binding RightToolRoot.IsAutoHidden}" Value="True">
                            <Setter TargetName="Col_RightTool" Property="Width" Value="0" />
                            <Setter TargetName="PART_RightSplitter" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>


                        <!--  =========================================================================  -->
                        <!--  👈 【左エリア】の自動消滅＆緊縮トリガー  -->
                        <!--  =========================================================================  -->
                        <DataTrigger Binding="{Binding LeftToolRoot}" Value="{x:Null}">
                            <Setter TargetName="Col_LeftTool" Property="Width" Value="0" />
                            <Setter TargetName="PART_LeftSplitter" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding LeftToolRoot.IsAutoHidden}" Value="True">
                            <Setter TargetName="Col_LeftTool" Property="Width" Value="0" />
                            <Setter TargetName="PART_LeftSplitter" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>


                        <!--  =========================================================================  -->
                        <!--  👆 【上エリア】の自動消滅＆緊縮トリガー  -->
                        <!--  =========================================================================  -->
                        <DataTrigger Binding="{Binding TopToolRoot}" Value="{x:Null}">
                            <Setter TargetName="Row_TopTool" Property="Height" Value="0" />
                            <Setter TargetName="PART_TopSplitter" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding TopToolRoot.IsAutoHidden}" Value="True">
                            <Setter TargetName="Row_TopTool" Property="Height" Value="0" />
                            <Setter TargetName="PART_TopSplitter" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>


                        <!--  =========================================================================  -->
                        <!--  👇 【下エリア】の自動消滅＆緊縮トリガー  -->
                        <!--  =========================================================================  -->
                        <DataTrigger Binding="{Binding BottomToolRoot}" Value="{x:Null}">
                            <Setter TargetName="Row_BottomTool" Property="Height" Value="0" />
                            <Setter TargetName="PART_BottomSplitter" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding BottomToolRoot.IsAutoHidden}" Value="True">
                            <Setter TargetName="Row_BottomTool" Property="Height" Value="0" />
                            <Setter TargetName="PART_BottomSplitter" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  =========================================================================  -->
    <!--  🌲 【再帰解決エンジン】 具象クラス解決用の DataTemplate をここに配置  -->
    <!--  =========================================================================  -->
    <!--  =========================================================================  -->
    <!--  🌲 【再帰解決エンジン】 具象クラス解決用の DataTemplate  -->
    <!--  =========================================================================  -->
    <DataTemplate DataType="{x:Type models:PaneContentNode}">
        <local:DockingPane />
    </DataTemplate>



    <!--  =========================================================================  -->
    <!--  🛠️ 【UIコアエンジン】中央ツリーと右ツールペインを1インフラで共通統治  -->
    <!--  =========================================================================  -->
    <Style TargetType="{x:Type local:DockingPane}">
        <Setter Property="Background" Value="#FF1E1E1E" />
        <Setter Property="BorderBrush" Value="#FF3E3E42" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:DockingPane}">
                    <Grid Visibility="{Binding IsAutoHidden, Converter={StaticResource TrueToCollapsedConverter}}">
                        <!--  【状態②：マルチタブ実体状態（通常フォルダ ＆ ツール共通枠）】  -->
                        <Border
                            x:Name="LeafVisual"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Visibility="Collapsed">
                            <DockPanel>
                                <ItemsControl
                                    x:Name="PART_TabHeader"
                                    Background="#FF2D2D30"
                                    DockPanel.Dock="Top"
                                    ItemsSource="{Binding TabViewModels}">
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="{x:Type ItemsControl}">
                                            <Border Background="{TemplateBinding Background}" BorderThickness="0">
                                                <ScrollViewer
                                                    x:Name="PART_HeaderScrollViewer"
                                                    HorizontalScrollBarVisibility="Hidden"
                                                    VerticalScrollBarVisibility="Disabled">
                                                    <ItemsPresenter />
                                                </ScrollViewer>
                                            </Border>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                x:Name="TabItemBorder"
                                                Width="Auto"
                                                MinWidth="80"
                                                Margin="1,2,1,0"
                                                Padding="10,4,6,4"
                                                Background="#FF2D2D30"
                                                BorderBrush="#FF3E3E42"
                                                BorderThickness="1,1,1,0"
                                                CornerRadius="3,3,0,0"
                                                Cursor="Hand">

                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="20" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        FontSize="24"
                                                        Foreground="#FFDFDFDF"
                                                        Text="{Binding Title}"
                                                        ToolTip="{Binding Title}" />
                                                    <Button
                                                        x:Name="PART_TabCloseButton"
                                                        Grid.Column="1"
                                                        Width="14"
                                                        Height="14"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Arrow"
                                                        Focusable="False">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border
                                                                    x:Name="ButtonBorder"
                                                                    Background="Transparent"
                                                                    CornerRadius="2">
                                                                    <Path
                                                                        x:Name="CrossPath"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        Data="M3,3 L11,11 M11,3 L3,11"
                                                                        Stroke="#FF999999"
                                                                        StrokeThickness="1.2" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="ButtonBorder" Property="Background" Value="#FFC42B1C" />
                                                                        <Setter TargetName="CrossPath" Property="Stroke" Value="#FFFFFFFF" />
                                                                    </Trigger>

                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>


                                                    <uc:PinButton
                                                        Grid.Column="2"
                                                        Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType={x:Type local:DockingPane}}}"
                                                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type viewModels:DockingPaneViewModel}}}"
                                                        IsPinned="{Binding DataContext.IsPinned, RelativeSource={RelativeSource AncestorType={x:Type local:DockingPane}}}" />



                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid
                                    x:Name="PART_TabContentContainer"
                                    Background="#FF1E1E1E"
                                    TextBlock.Foreground="#FFDFDFDF">
                                    <ContentPresenter Content="{Binding DataContext.ActiveViewModel, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <Grid
                                        x:Name="PART_DockingIndicator"
                                        Width="120"
                                        Height="120"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                        <Ellipse
                                            Fill="#80000000"
                                            Stroke="#FF3E3E42"
                                            StrokeThickness="1" />
                                        <Grid>
                                            <Border
                                                x:Name="PART_IndicatorCenter"
                                                Width="24"
                                                Height="24"
                                                Background="#FF2D2D30"
                                                BorderBrush="#FF007ACC"
                                                BorderThickness="1"
                                                CornerRadius="2"
                                                Visibility="{Binding IsToolPane, Converter={StaticResource TrueToCollapsedConverter}}">
                                                <Rectangle
                                                    Width="12"
                                                    Height="12"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Fill="#FF007ACC" />
                                            </Border>
                                            <Border
                                                x:Name="PART_IndicatorTop"
                                                Width="24"
                                                Height="24"
                                                Margin="0,4,0,0"
                                                VerticalAlignment="Top"
                                                Background="#FF2D2D30"
                                                BorderBrush="#FF007ACC"
                                                BorderThickness="1"
                                                CornerRadius="2">
                                                <Rectangle
                                                    Width="14"
                                                    Height="6"
                                                    Margin="0,3,0,0"
                                                    VerticalAlignment="Top"
                                                    Fill="#FF007ACC" />
                                            </Border>
                                            <Border
                                                x:Name="PART_IndicatorBottom"
                                                Width="24"
                                                Height="24"
                                                Margin="0,0,0,4"
                                                VerticalAlignment="Bottom"
                                                Background="#FF2D2D30"
                                                BorderBrush="#FF007ACC"
                                                BorderThickness="1"
                                                CornerRadius="2">
                                                <Rectangle
                                                    Width="14"
                                                    Height="6"
                                                    Margin="0,0,0,3"
                                                    VerticalAlignment="Bottom"
                                                    Fill="#FF007ACC" />
                                            </Border>
                                            <Border
                                                x:Name="PART_IndicatorLeft"
                                                Width="24"
                                                Height="24"
                                                Margin="4,0,0,0"
                                                HorizontalAlignment="Left"
                                                Background="#FF2D2D30"
                                                BorderBrush="#FF007ACC"
                                                BorderThickness="1"
                                                CornerRadius="2">
                                                <Rectangle
                                                    Width="6"
                                                    Height="14"
                                                    Margin="3,0,0,0"
                                                    HorizontalAlignment="Left"
                                                    Fill="#FF007ACC" />
                                            </Border>
                                            <Border
                                                x:Name="PART_IndicatorRight"
                                                Width="24"
                                                Height="24"
                                                Margin="0,0,4,0"
                                                HorizontalAlignment="Right"
                                                Background="#FF2D2D30"
                                                BorderBrush="#FF007ACC"
                                                BorderThickness="1"
                                                CornerRadius="2">
                                                <Rectangle
                                                    Width="6"
                                                    Height="14"
                                                    Margin="0,0,3,0"
                                                    HorizontalAlignment="Right"
                                                    Fill="#FF007ACC" />
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </DockPanel>
                        </Border>


                        <Grid x:Name="PART_VerticalSplitGrid" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" Content="{Binding MainChild}" />
                            <GridSplitter
                                x:Name="PART_VerticalSplitBar"
                                Grid.Column="1"
                                Width="4"
                                HorizontalAlignment="Stretch"
                                Background="#FF3E3E42"
                                ShowsPreview="False" />
                            <ContentPresenter Grid.Column="2" Content="{Binding SubChild}" />
                            <Border
                                x:Name="PART_VerticalSplitterIndicator"
                                Grid.Column="1"
                                Width="48"
                                Margin="-22,0,-22,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Stretch"
                                Background="#440000CC"
                                BorderBrush="#FF007ACC"
                                BorderThickness="1,0,1,0"
                                IsHitTestVisible="True"
                                Visibility="Collapsed">
                                <Border.Effect>
                                    <BlurEffect Radius="2" />
                                </Border.Effect>
                            </Border>
                        </Grid>
                        <Grid x:Name="PART_HorizontalSplitGrid" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter Grid.Row="0" Content="{Binding MainChild}" />

                            <GridSplitter
                                x:Name="PART_HorizontalSplitBar"
                                Grid.Row="1"
                                Height="4"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Background="#FF3E3E42"
                                ShowsPreview="False" />
                            <ContentPresenter Grid.Row="2" Content="{Binding SubChild}" />

                            <Border
                                x:Name="PART_HorizontalSplitterIndicator"
                                Grid.Row="1"
                                Height="48"
                                Margin="0,-22,0,-22"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Background="#440000CC"
                                BorderBrush="#FF007ACC"
                                BorderThickness="0,1,0,1"
                                IsHitTestVisible="True"
                                Visibility="Collapsed">
                                <Border.Effect>
                                    <BlurEffect Radius="2" />
                                </Border.Effect>
                            </Border>
                        </Grid>



                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="LayoutStates">
                                <VisualState x:Name="LeafState">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LeafVisual" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="VerticalState">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_VerticalSplitGrid" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="HorizontalState">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_HorizontalSplitGrid" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!--  💡 部屋のDataContext（PaneContentNode）の IsToolPane が True のとき発動  -->
                        <DataTrigger Binding="{Binding IsToolPane}" Value="True">

                            <!--  1. タブヘッダー（PART_TabHeader）を DockPanel の「下（Bottom）」に引っ越しさせる！  -->
                            <Setter TargetName="PART_TabHeader" Property="DockPanel.Dock" Value="Bottom" />

                            <!--  2. ツールウィンドウ専用の背景色と枠線に変更する（VS風の少し明るいグレー）  -->
                            <Setter Property="Background" Value="#FF2D2D30" />
                            <Setter Property="BorderBrush" Value="#FF3F3F46" />

                        </DataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsToolPane}" Value="True" />
                                <Condition Binding="{Binding IsAutoHidden}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.Setters>
                                <Setter TargetName="PART_TabHeader" Property="DockPanel.Dock" Value="Right" />
                                <Setter TargetName="PART_TabContentContainer" Property="Visibility" Value="Collapsed" />

                            </MultiDataTrigger.Setters>
                        </MultiDataTrigger>






                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>



    </Style>
</ResourceDictionary>
