<UserControl x:Class="TokiDockingPane.UserControls.PinButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TokiDockingPane.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"  >

    <Button Width="16" Height="16"
            Background="Transparent" BorderThickness="0" Focusable="False" Cursor="Hand"
            Command="{Binding Command, RelativeSource={RelativeSource AncestorType={x:Type local:PinButton}}}"
            CommandParameter="{Binding CommandParameter, RelativeSource={RelativeSource AncestorType={x:Type local:PinButton}}}">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}">
                    <Path x:Name="PinPath"
                          Data="M 8,2 L 8,6 L 5,6 L 5,8 L 7,11 L 7,14 L 8,14 L 8,11 L 10,8 L 10,6 L 7,6" 
                          Stroke="#FFDCDCDC" StrokeThickness="1"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </Path.RenderTransform>
                    </Path>
                </Border>

                <ControlTemplate.Triggers>
                    <!-- ⚡ DataTrigger も RelativeSource で確実に狙い撃ち -->
                    <DataTrigger Binding="{Binding IsPinned, RelativeSource={RelativeSource AncestorType={x:Type local:PinButton}}}" Value="False">
                        <Setter TargetName="PinPath" Property="Stroke" Value="#FF007ACC"/>
                        <Setter TargetName="PinPath" Property="RenderTransform">
                            <Setter.Value>
                                <RotateTransform Angle="90"/>
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>
    </Button>

</UserControl>
