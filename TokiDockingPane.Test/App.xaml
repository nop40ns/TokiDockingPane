<Application x:Class="TokiDockingPane.Test.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TokiDockingPane.Test"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
            <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 🎯 別プロジェクト（クラスライブラリ側）のGeneric.xamlを完璧にマージしてアプリへ叩き込む -->
                <ResourceDictionary Source="pack://application:,,,/TokiDockingPane;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
